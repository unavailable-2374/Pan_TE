# --- TE-looker discovery post-processing -------------------------------------
# A base dtr run emits de novo seed-derived consensi; when supplied, its Track 1
# nhmmer recruitment adds HMM-supported members before refinement. Either source can
# still contain offset fragments, so only a dtr --final-gated run that writes the explicit
# TE_LOOKER_GATED_CONTRACT bypasses Pan_TE's bounded host-side stitch/gate/merge fallback.
# A bare provenance.json is never sufficient: this prevents partial/corrupt state from
# silently bypassing the only anti-inflation boundary.
TE_LOOKER_PROVENANCE = 'provenance.json'
TE_LOOKER_GATED_CONTRACT = 'te-looker-gated-v1'
TE_LOOKER_HANDOFF_PROVENANCE = 'pan_te_handoff.json'
TE_LOOKER_MIN_COPIES = 5                  # drop families with fewer recruited members
TE_LOOKER_MIN_LEN = 100                   # drop consensi shorter than this (bp)
TE_LOOKER_MERGE_IDENTITY = 0.80           # cd-hit-est identity for cross-seed merge
# Loud-warning bound on the gated family count: maize-scale genomes legitimately carry
# thousands of TE families, but a count above genome_Mb * this factor signals the gate
# did not collapse the discovery inflation and the library should not be trusted.
TE_LOOKER_SANITY_FAMILIES_PER_MB = 15

# --- te-discover memory model -------------------------------------------------------
# te_core::harvest() packs one u128 (16 bytes) per emitted k-mer occurrence. At w=1 that
# is one entry per genomic position (exact mode, reproduces jellyfish); at w>1 only
# (w,k)-minimizers are emitted, whose expected density is 2/(w+1). te-looker <=0.3.0
# additionally holds two full copies at once (`chunks` stays live across
# `chunks.concat()` in core/src/lib.rs), which is what turns a 3.1 Gb genome into a
# ~100 GB peak. The genome itself is resident throughout as one byte per base.
TE_LOOKER_BYTES_PER_ENTRY = 16
TE_LOOKER_SAFETY_FACTOR = 1.15   # seed occurrence lists + allocator slack
# te-looker releases at or above this version release `chunks` before sorting.
TE_LOOKER_SINGLE_COPY_VERSION = (0, 3, 1)
# --window-stride belongs to the window-graph mode, which no released dtr implements.
# It is NOT an alias for --w: stride is a graph-vertex spacing, w is a minimizer window,
# and quietly mapping one onto the other would subsample k-mers by a factor nobody asked
# for. Pan_TE therefore withholds the flag until a dtr that genuinely implements it ships.
TE_LOOKER_STRIDE_VERSION = (0, 4, 0)


def minimizer_density(w: int) -> float:
    """Expected fraction of k-mer occurrences retained by a (w,k)-minimizer scheme."""
    return 1.0 if w <= 1 else 2.0 / (w + 1)


def estimate_te_looker_peak_bytes(genome_bp: int, w: int, double_copy: bool) -> int:
    """Estimated peak RSS of the te-discover seed-harvest stage."""
    entries = genome_bp * minimizer_density(w)
    packed = entries * TE_LOOKER_BYTES_PER_ENTRY * (2 if double_copy else 1)
    return int((packed + genome_bp) * TE_LOOKER_SAFETY_FACTOR)


def _read_int_file(path: str) -> Optional[int]:
    try:
        with open(path) as fh:
            value = fh.read().strip()
        return None if value in ('', 'max') else int(value)
    except (OSError, ValueError):
        return None


def detect_memory_limit(explicit_mb: int = 0) -> Optional[Dict[str, int]]:
    """Smallest memory ceiling this process is actually subject to, with its source.

    A cluster job is usually capped far below the node's physical RAM, so reading
    /proc/meminfo alone would happily green-light a run the scheduler then kills.
    Every discoverable ceiling is collected and the minimum wins. Returns None when
    nothing at all could be determined (rather than guessing).
    """
    limits: Dict[str, int] = {}

    if explicit_mb and explicit_mb > 0:
        limits['-M'] = explicit_mb * 1024 ** 2

    try:
        with open('/proc/meminfo') as fh:
            for line in fh:
                if line.startswith('MemAvailable:'):
                    limits['/proc/meminfo MemAvailable'] = int(line.split()[1]) * 1024
                    break
    except (OSError, ValueError, IndexError):
        pass

    # cgroup v2, then v1. v1 reports a sentinel near 2^63 when unlimited.
    v2 = _read_int_file('/sys/fs/cgroup/memory.max')
    if v2:
        limits['cgroup v2 memory.max'] = v2
    v1 = _read_int_file('/sys/fs/cgroup/memory/memory.limit_in_bytes')
    if v1 and v1 < 2 ** 62:
        limits['cgroup v1 memory.limit_in_bytes'] = v1

    # SLURM allocations. --mem lands in SLURM_MEM_PER_NODE, --mem-per-cpu needs scaling.
    try:
        per_node = os.environ.get('SLURM_MEM_PER_NODE')
        if per_node:
            limits['SLURM_MEM_PER_NODE'] = int(per_node) * 1024 ** 2
        per_cpu = os.environ.get('SLURM_MEM_PER_CPU')
        cpus = os.environ.get('SLURM_CPUS_ON_NODE') or os.environ.get('SLURM_JOB_CPUS_PER_NODE')
        if per_cpu and cpus:
            limits['SLURM_MEM_PER_CPU'] = int(per_cpu) * int(cpus.split('(')[0]) * 1024 ** 2
    except (ValueError, TypeError):
        pass

    if not limits:
        return None
    source = min(limits, key=lambda k: limits[k])
    return {'bytes': limits[source], 'source': source, 'all': limits}


def human_bytes(n: float) -> str:
    for unit in ('B', 'KB', 'MB', 'GB', 'TB'):
        if abs(n) < 1024 or unit == 'TB':
            return f"{n:.1f} {unit}" if unit != 'B' else f"{int(n)} B"
        n /= 1024
    return f"{n:.1f} TB"


def q(path) -> str:
    """Shell-quote one command argument."""
    return shlex.quote(os.fspath(path))


def _cmd_label(cmd: str) -> str:
    """Extract a short label from a command string for logging."""
    try:
        token = shlex.split(cmd)[0]
    except ValueError:
        token = cmd.split()[0]
    return os.path.basename(token)

def resolve_ltr_library_builder() -> str:
    """Locate Look4LTRs' Python helper without requiring a submodule."""
    candidates = []
    override = os.environ.get('PAN_TE_LTR_LIBRARY_BUILDER')
    if override:
        candidates.append(override)

    # Installed Pan_TE lives at $PREFIX/share/pan_te/Pan_TE.
    package_prefix = Path(BIN_DIR).parent.parent
    candidates.append(package_prefix / 'share' / 'Look4LTRs' / 'build_ltr_library.py')
    conda_prefix = os.environ.get('CONDA_PREFIX')
    if conda_prefix:
        candidates.append(Path(conda_prefix) / 'share' / 'Look4LTRs' / 'build_ltr_library.py')

    # Compatibility with older packages, then source-development fallback.
    candidates.append(Path(BIN_DIR).parent / 'submodule' / 'Look4LTRs' /
                      'build_ltr_library.py')
    candidates.append(Path(BIN_DIR).parent.parent / 'submodule' / 'Look4LTRs' /
                      'build_ltr_library.py')
    for candidate in candidates:
        candidate = Path(candidate).expanduser()
        if candidate.is_file():
            return str(candidate.resolve())

    searched = '\n  - '.join(str(Path(candidate).expanduser()) for candidate in candidates)
    raise FileNotFoundError(
        'build_ltr_library.py was not found. Install the Conda look4ltrs package, '
        'set PAN_TE_LTR_LIBRARY_BUILDER, or initialise the Look4LTRs development '
        f'submodule. Searched:\n  - {searched}')

def detect_compression_format(file_path: str) -> str:
    """
    Detect the compression format of a file.
    
    Returns:
        'gzip' for .gz files
        'bzip2' for .bz2 files  
        'uncompressed' for regular files
    """
    file_path_lower = file_path.lower()
    
    if file_path_lower.endswith('.gz'):
        return 'gzip'
    elif file_path_lower.endswith('.bz2'):
        return 'bzip2'
    else:
        return 'uncompressed'

def is_fasta_file(file_path: str) -> bool:
    """
    Check if a file is a FASTA file based on extension.
    Supports both compressed and uncompressed formats.
    """
    file_path_lower = file_path.lower()
    
    # Remove compression extensions first
    if file_path_lower.endswith('.gz'):
        file_path_lower = file_path_lower[:-3]
    elif file_path_lower.endswith('.bz2'):
        file_path_lower = file_path_lower[:-4]
    
    # Check for FASTA extensions
    return file_path_lower.endswith(('.fa', '.fasta', '.fna', '.fas'))


def open_text_auto(file_path: str):
    """Open plain, gzip, or bzip2 text input by filename suffix."""
    compression_format = detect_compression_format(file_path)
    if compression_format == 'gzip':
        return gzip.open(file_path, 'rt')
    if compression_format == 'bzip2':
        return bz2.open(file_path, 'rt')
    return open(file_path, 'rt')


def read_fasta_seqnames(file_path: str):
    """Return FASTA primary sequence identifiers, rejecting bad headers."""
    names = []
    with open_text_auto(file_path) as handle:
        for line_number, line in enumerate(handle, 1):
            if not line.startswith('>'):
                continue
            name = line[1:].strip().split(None, 1)[0]
            if not name:
                raise ValueError(
                    f"Empty FASTA identifier in {file_path} at line {line_number}")
            names.append(name)
    if not names:
        raise ValueError(f"No FASTA sequences found in {file_path}")
    return names

def decompress_file(input_file: str, output_file: str = None) -> str:
    """
    Decompress a file if it's compressed, otherwise return original path.
    
    Args:
        input_file: Path to potentially compressed file
        output_file: Optional output path for decompressed file
        
    Returns:
        Path to decompressed file (or original if not compressed)
    """
    compression_format = detect_compression_format(input_file)
    
    if compression_format == 'uncompressed':
        return input_file
    
    # Create temp file if no output specified
    if output_file is None:
        temp_fd, output_file = tempfile.mkstemp(suffix='.fa', prefix='pan_te_genome_')
        os.close(temp_fd)
    
    try:
        if compression_format == 'gzip':
            with gzip.open(input_file, 'rt') as infile, open(output_file, 'w') as outfile:
                outfile.write(infile.read())
        elif compression_format == 'bzip2':
            with bz2.open(input_file, 'rt') as infile, open(output_file, 'w') as outfile:
                outfile.write(infile.read())
        return output_file

    except Exception as e:
        if output_file and os.path.exists(output_file):
            os.remove(output_file)
        logger.error(f"Decompression failed: {e}")
        raise

class CustomArgumentParser(argparse.ArgumentParser):
    def format_help(self):
        return USAGE

    def error(self, message):
        sys.stderr.write(f'error: {message}\n\n')
        self.print_help()
        sys.exit(2)

def parse_arguments():
    """Parse command line arguments with custom help format."""
    parser = CustomArgumentParser(add_help=False)
    
    # General options
    parser.add_argument('--genome', 
                       type=str,
                       help='Genome file in FASTA format')
    parser.add_argument('--model-dir',
                       type=str,
                       help='Path to ClassifyTE for classification')
    
    # Other options
    parser.add_argument('--vcf-dir',
                       type=str,
                       help='Path for VCF files')
    parser.add_argument('--paf',
                       type=str,
                       help='PAF file from all-vs-all genome alignment')
    parser.add_argument('--paf-fasta',
                       type=str,
                       nargs='+',
                       help='Assembly FASTA file(s) for PAF (accepts multiple files)')
    parser.add_argument('--paf-mapping',
                       type=str,
                       help='Chromosome mapping TSV (seqname, assembly_id, chr_id)')
    parser.add_argument('--gfa',
                       type=str,
                       help='GFA file from pangenome graph (rGFA or PGGB)')
    parser.add_argument('--gfa-ref',
                       type=str,
                       help='Reference path/sample name in GFA (auto-detected if omitted)')
    parser.add_argument('--gfa-mode',
                       choices=('alleles', 'legacy'),
                       default='alleles',
                       help='PGGB candidate extraction mode')
    parser.add_argument('--gfa-gaf',
                       type=str,
                       help='Primary GAF used to recover rGFA sample paths')
    parser.add_argument('--gfa-gaf-fasta',
                       type=str,
                       help='Query FASTA used to validate GAF names and lengths')
    parser.add_argument('--gfa-gaf-min-mapq',
                       type=int, default=20,
                       help='Minimum MAPQ for rGFA GAF candidate and presence calls')
    parser.add_argument('--gfa-gaf-min-identity',
                       type=float, default=0.90,
                       help='Minimum matches/block-length identity for rGFA GAF calls')
    parser.add_argument('--gfa-window-overlap',
                       type=int,
                       default=1000,
                       help='Overlap for alternate-allele windows over 30 kb')
    parser.add_argument('--gfa-spacer-length',
                       type=int,
                       default=0,
                       help='N spacer length; 0 emits independent FASTA records')
    parser.add_argument('--gfa-clean-intermediates',
                       action='store_true',
                       help='Remove candidate FASTA intermediates after processing')
    parser.add_argument('--anno',
                       action='store_true',
                       help='Project all-genome TE/GFF3 annotations onto GFA nodes')
    parser.add_argument('--anno-only',
                       action='store_true',
                       help='Run only all-genome annotation projection')
    parser.add_argument('--anno-manifest',
                       type=str,
                       help='TSV manifest of per-genome GFF3/TE annotations')
    parser.add_argument('--anno-te-min-fraction',
                       type=float, default=0.80,
                       help='Minimum TE-covered fraction for a TE call')
    parser.add_argument('--anno-partial-min-fraction',
                       type=float, default=0.10,
                       help='Minimum TE-covered fraction for a PartialTE call')
    parser.add_argument('--out-dir', '--out',
                       dest='out_dir',
                       type=str,
                       default=os.getcwd(),
                       help='Work directory')
    parser.add_argument('--te-looker-bin',
                       type=str,
                       help='Path to te-looker dtr binary')
    parser.add_argument('--te-looker-extra-args',
                       type=str,
                       default='',
                       help='Extra arguments passed verbatim to dtr run')
    parser.add_argument('--te-looker-final-gated',
                       action='store_true',
                       help='Require dtr internal stitch/gate/merge and its explicit '
                            'te-looker-gated-v1 output contract')
    parser.add_argument('--te-looker-w',
                       type=int,
                       default=1,
                       help='te-discover minimizer window (default 1 = exact, every '
                            'k-mer). Values >1 subsample k-mers to ~2/(w+1) of their '
                            'occurrences, cutting memory roughly proportionally, and '
                            'CHANGE the seed set; --min-count is re-derived to match.')
    parser.add_argument('--check-env',
                       action='store_true',
                       help='Run the environment preflight and exit without running the '
                            'pipeline')
    parser.add_argument('-M',
                       type=int,
                       default=0,
                       help='Memory limit in MB')
    parser.add_argument('--threads',
                       type=int,
                       default=4,
                       help='Number of threads')
    parser.add_argument('--fragment-size', '--fragment_size',
                       dest='fragment_size',
                       type=int,
                       default=40000,
                       help='Length for fragment')
    parser.add_argument('--help', '-h',
                       action='help',
                       help='Display help information')
    
    args = parser.parse_args()

    if args.anno_only:
        args.anno = True
    if args.anno_only and args.check_env:
        parser.error('--anno-only and --check-env are mutually exclusive')

    if args.threads < 1:
        parser.error('--threads must be a positive integer')

    # Validate: at least --genome, --paf, or --gfa required
    if not args.genome and not args.paf and not args.gfa:
        parser.error('At least one of --genome, --paf, or --gfa must be provided')

    # --paf and --gfa are mutually exclusive
    if args.paf and args.gfa:
        parser.error('--paf and --gfa are mutually exclusive; provide one or the other')

    # Validate genome file exists and is FASTA format
    if args.genome:
        if not os.path.exists(args.genome):
            parser.error(f'Genome file not found: {args.genome}')
        if not is_fasta_file(args.genome):
            parser.error(f'Genome file must be in FASTA format (.fa, .fasta, .fna, .fas), optionally compressed (.gz, .bz2): {args.genome}')

    # Validate PAF arguments
    if args.paf:
        if not os.path.exists(args.paf):
            parser.error(f'PAF file not found: {args.paf}')
        if not args.paf_fasta:
            parser.error('--paf-fasta is required when --paf is specified')
        for fasta_file in args.paf_fasta:
            if not os.path.exists(fasta_file):
                parser.error(f'PAF FASTA not found: {fasta_file}')
            if not is_fasta_file(fasta_file):
                parser.error(f'PAF FASTA has an unsupported extension: {fasta_file}')
        if args.paf_mapping and not os.path.exists(args.paf_mapping):
            parser.error(f'PAF mapping file not found: {args.paf_mapping}')

    # Validate GFA arguments
    if args.gfa:
        if not os.path.exists(args.gfa):
            parser.error(f'GFA file not found: {args.gfa}')
    if args.gfa_ref and not args.gfa:
        parser.error('--gfa-ref requires --gfa')
    if args.gfa_gaf and not args.gfa:
        parser.error('--gfa-gaf requires --gfa')
    if args.gfa_gaf_fasta and not args.gfa_gaf:
        parser.error('--gfa-gaf-fasta requires --gfa-gaf')
    if args.gfa_gaf and not os.path.isfile(args.gfa_gaf):
        parser.error(f'GAF file not found: {args.gfa_gaf}')
    if args.gfa_gaf_fasta:
        if not os.path.isfile(args.gfa_gaf_fasta):
            parser.error(f'GAF query FASTA not found: {args.gfa_gaf_fasta}')
        if not is_fasta_file(args.gfa_gaf_fasta):
            parser.error('--gfa-gaf-fasta must be a FASTA file')
    if args.gfa_gaf_min_mapq < 0:
        parser.error('--gfa-gaf-min-mapq must be non-negative')
    if not 0 <= args.gfa_gaf_min_identity <= 1:
        parser.error('--gfa-gaf-min-identity must be between 0 and 1')
    if args.gfa_window_overlap < 0 or args.gfa_window_overlap >= 30000:
        parser.error('--gfa-window-overlap must satisfy 0 <= overlap < 30000')
    if args.gfa_spacer_length < 0:
        parser.error('--gfa-spacer-length must be non-negative')
    if args.anno and not args.gfa:
        parser.error('--anno requires --gfa')
    if args.anno and not args.anno_manifest:
        parser.error('--anno requires --anno-manifest')
    if args.anno_manifest and not args.anno:
        parser.error('--anno-manifest requires --anno')
    if args.anno_manifest and not os.path.isfile(args.anno_manifest):
        parser.error(f'Annotation manifest not found: {args.anno_manifest}')
    if not (0 <= args.anno_partial_min_fraction <= args.anno_te_min_fraction <= 1):
        parser.error('annotation fractions must satisfy 0 <= partial <= TE <= 1')

    if args.vcf_dir:
        if not args.genome:
            parser.error('--vcf-dir requires --genome')
        if not os.path.isdir(args.vcf_dir):
            parser.error(f'VCF directory not found: {args.vcf_dir}')

    return args

BIN_DIR = os.path.dirname(os.path.abspath(__file__))


class PanTEPipeline:
    """Implementation of the Pan TE Pipeline with step tracking and checkpoints."""

    def __init__(self, genome_file: Optional[str], output_dir: str, threads: int = 4,
                 model_dir: Optional[str] = None, vcf_dir: Optional[str] = None,
                 paf_file: Optional[str] = None, paf_fasta=None,
                 paf_mapping: Optional[str] = None,
                 gfa_file: Optional[str] = None, gfa_ref: Optional[str] = None,
                 gfa_mode: str = 'alleles', gfa_window_overlap: int = 1000,
                 gfa_spacer_length: int = 0,
                 gfa_keep_intermediates: bool = True,
                 gfa_gaf: Optional[str] = None,
                 gfa_gaf_fasta: Optional[str] = None,
                 gfa_gaf_min_mapq: int = 20,
                 gfa_gaf_min_identity: float = 0.90,
                 anno: bool = False,
                 anno_manifest: Optional[str] = None,
                 anno_te_min_fraction: float = 0.80,
                 anno_partial_min_fraction: float = 0.10,
                 te_looker_bin: Optional[str] = None,
                 te_looker_extra_args: str = '',
                 te_looker_final_gated: bool = False,
                 te_looker_w: int = 1,
                 memory_limit_mb: int = 0):
        """Initialize the pipeline with configuration parameters."""
        self.original_genome_file = os.path.abspath(genome_file) if genome_file else None
        self.genome_file = None  # Will be set after decompression if needed
        self.decompressed_genome_file = None  # Track decompressed temp file for cleanup
        self.vcf_dir = os.path.abspath(vcf_dir) if vcf_dir else None
        self.paf_file = os.path.abspath(paf_file) if paf_file else None
        self.paf_fasta_files = [os.path.abspath(f) for f in paf_fasta] if paf_fasta else None
        self.paf_mapping = os.path.abspath(paf_mapping) if paf_mapping else None
        self.gfa_file = os.path.abspath(gfa_file) if gfa_file else None
        self.gfa_ref = gfa_ref
        self.gfa_mode = gfa_mode
        self.gfa_window_overlap = gfa_window_overlap
        self.gfa_spacer_length = gfa_spacer_length
        self.gfa_keep_intermediates = gfa_keep_intermediates
        self.gfa_gaf = os.path.abspath(gfa_gaf) if gfa_gaf else None
        self.gfa_gaf_fasta = (os.path.abspath(gfa_gaf_fasta)
                              if gfa_gaf_fasta else None)
        self.gfa_gaf_min_mapq = int(gfa_gaf_min_mapq)
        self.gfa_gaf_min_identity = float(gfa_gaf_min_identity)
        self.anno_enabled = bool(anno)
        self.anno_manifest = (os.path.abspath(anno_manifest)
                              if anno_manifest else None)
        self.anno_te_min_fraction = float(anno_te_min_fraction)
        self.anno_partial_min_fraction = float(anno_partial_min_fraction)
        self.output_dir = os.path.abspath(output_dir)
        self.threads = threads
        self.model_dir = os.path.abspath(model_dir) if model_dir else None
        self.te_looker_bin = os.path.abspath(te_looker_bin) if te_looker_bin else None
        self.te_looker_extra_args = te_looker_extra_args or ''
        self.te_looker_final_gated = bool(te_looker_final_gated)
        self.te_looker_w = max(1, int(te_looker_w or 1))
        self.memory_limit_mb = int(memory_limit_mb or 0)
        self._dtr_caps: Optional[Dict] = None
        self.processed_genome = os.path.join(self.output_dir, DIR_GENOME, 'genome.fa')

        # Set genome_file initially to original file path for validation
        # Actual decompression will happen in process_genome() only if needed
        if self.original_genome_file:
            self.genome_file = self.original_genome_file

        # Verify inputs
        if not self.genome_file and not self.vcf_dir and not self.paf_file and not self.gfa_file:
            raise ValueError("Either genome_file, vcf_dir, paf_file, or gfa_file must be provided")
        
        # Thread allocation: LTR and mdl-repeat share threads
        self.ltr_threads = max(1, threads // 2)
        self.mdl_threads = max(1, threads)

        logger.info(f"Thread allocation: Total={threads}, LTR={self.ltr_threads}, mdl-repeat={self.mdl_threads}")

        # Pipeline steps and their checkpoints
        self.steps = {
            'vcf': 'vcf.ok',
            'genome': 'genome.ok',
            'ltr': 'LTR.ok',
            'mdl_repeat': 'mdl-repeat.ok',
            'te_looker': 'te-looker.ok',
            'combine': 'combine.ok',
            'anno': 'anno.ok'
        }
        self.legacy_steps = {
            'mdl_repeat': 'mdl_repeat.ok',
            'te_looker': 'RepGraph.ok',
            'combine': 'Combine.ok'
        }
        self.processes = {
            'genome': self.process_genome,
            'ltr': self.process_ltr,
            'mdl_repeat': self.process_mdl_repeat,
            'te_looker': self.process_te_looker,
            'combine': self.combine_results,
            'anno': self.annotate_gfa
        }
        # NOTE: the output directory structure is deliberately NOT created here. It is
        # created by run(), so that constructing a pipeline (as --check-env and the
        # preflight do) leaves the filesystem untouched when the environment turns out
        # to be unusable.

    def stage_dir(self, canonical: str, legacy: Optional[str] = None) -> str:
        """Return the canonical stage directory, falling back to an existing legacy one."""
        canonical_path = os.path.join(self.output_dir, canonical)
        legacy_path = os.path.join(self.output_dir, legacy) if legacy else None
        canonical_has_files = False
        if os.path.isdir(canonical_path):
            with os.scandir(canonical_path) as entries:
                canonical_has_files = any(entries)
        if legacy_path and os.path.exists(legacy_path) and not canonical_has_files:
            return legacy_path
        return canonical_path

    def prepare_genome_file(self):
        """Handle decompression of genome file if needed."""
        if not self.original_genome_file:
            return

        compression_format = detect_compression_format(self.original_genome_file)

        if compression_format == 'uncompressed':
            self.genome_file = self.original_genome_file
        else:
            logger.info(f"Decompressing {compression_format} genome...")
            temp_genome = os.path.join(self.output_dir, DIR_GENOME, 'decompressed_genome.fa')
            os.makedirs(os.path.dirname(temp_genome), exist_ok=True)
            self.genome_file = decompress_file(self.original_genome_file, temp_genome)
            self.decompressed_genome_file = temp_genome

    def cleanup_temp_files(self):
        """Clean up temporary files created during processing."""
        if self.decompressed_genome_file and os.path.exists(self.decompressed_genome_file):
            try:
                os.remove(self.decompressed_genome_file)
            except Exception:
                pass

    def _prepare_paf_fasta(self, work_dir: str) -> str:
        """Prepare a single indexed FASTA from paf_fasta_files.

        If a single file is provided, indexes and returns it directly.
        If multiple files, concatenates into a combined FASTA, indexes, and returns.
        """
        seen = set()
        for fasta in self.paf_fasta_files:
            for name in read_fasta_seqnames(fasta):
                if name in seen:
                    raise ValueError(
                        f"Duplicate PAF FASTA sequence identifier {name!r}. "
                        "Sequence names must be unique across all assemblies.")
                seen.add(name)

        prepared_fastas = []
        for index, fasta in enumerate(self.paf_fasta_files, 1):
            if detect_compression_format(fasta) == 'uncompressed':
                prepared_fastas.append(fasta)
                continue
            prepared = os.path.join(work_dir, f'paf_assembly_{index}.fa')
            decompress_file(fasta, prepared)
            prepared_fastas.append(prepared)
        self.prepared_paf_fasta_files = prepared_fastas

        if len(prepared_fastas) == 1:
            fasta = prepared_fastas[0]
            if not os.path.exists(fasta + '.fai'):
                self.run_cmd(f"samtools faidx {q(fasta)}")
            return fasta

        combined = os.path.join(work_dir, 'multi_assembly.fa')
        logger.info(f"Combining {len(prepared_fastas)} assembly FASTA files...")
        with open(combined, 'wt') as out:
            for fasta in prepared_fastas:
                with open(fasta, 'rt') as inp:
                    shutil.copyfileobj(inp, out)
                out.write('\n')
        self.run_cmd(f"samtools faidx {q(combined)}")
        return combined

    def setup_directories(self):
        """Create the necessary directory structure."""
        for sub in [DIR_GENOME, DIR_MDL_REPEAT, DIR_TE_LOOKER, DIR_COMBINE, DIR_ANNO]:
            os.makedirs(os.path.join(self.output_dir, sub), exist_ok=True)

    def _gfa_fingerprint(self) -> dict:
        """Return input/config identity for safe GFA checkpoint reuse."""
        if not self.gfa_file:
            return {}
        gfa_stat = os.stat(self.gfa_file)
        fingerprint = {
            'algorithm': 'gfa_locus_alleles_v3_rgfa_gaf',
            'gfa': {
                'path': self.gfa_file,
                'size': gfa_stat.st_size,
                'mtime_ns': gfa_stat.st_mtime_ns,
            },
            'gfa_ref': self.gfa_ref,
            'gfa_mode': self.gfa_mode,
            'gfa_window_overlap': self.gfa_window_overlap,
            'gfa_spacer_length': self.gfa_spacer_length,
            'gfa_gaf_min_mapq': self.gfa_gaf_min_mapq,
            'gfa_gaf_min_identity': self.gfa_gaf_min_identity,
        }
        if self.gfa_gaf:
            gaf_stat = os.stat(self.gfa_gaf)
            fingerprint['gfa_gaf'] = {
                'path': self.gfa_gaf, 'size': gaf_stat.st_size,
                'mtime_ns': gaf_stat.st_mtime_ns,
            }
        if self.gfa_gaf_fasta:
            gaf_fasta_stat = os.stat(self.gfa_gaf_fasta)
            fingerprint['gfa_gaf_fasta'] = {
                'path': self.gfa_gaf_fasta, 'size': gaf_fasta_stat.st_size,
                'mtime_ns': gaf_fasta_stat.st_mtime_ns,
            }
        if self.original_genome_file:
            genome_stat = os.stat(self.original_genome_file)
            fingerprint['reference_genome'] = {
                'path': self.original_genome_file,
                'size': genome_stat.st_size,
                'mtime_ns': genome_stat.st_mtime_ns,
            }
        return fingerprint

    def _gfa_fingerprint_path(self) -> str:
        return os.path.join(
            self.output_dir, DIR_GENOME, 'gfa_enrichment',
            'gfa_run_fingerprint.json')

    def _write_gfa_fingerprint(self) -> None:
        if not self.gfa_file:
            return
        path = self._gfa_fingerprint_path()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w') as handle:
            json.dump(self._gfa_fingerprint(), handle, indent=2, sort_keys=True)

    def _validate_gfa_fingerprint(self) -> None:
        path = self._gfa_fingerprint_path()
        if not os.path.isfile(path):
            raise RuntimeError(
                'genome.ok exists but has no GFA input/config fingerprint; '
                'use a new --out-dir or remove stale checkpoints explicitly')
        with open(path) as handle:
            previous = json.load(handle)
        current = self._gfa_fingerprint()
        if previous != current:
            raise RuntimeError(
                'genome.ok was produced from a different GFA or GFA '
                'configuration; use a new --out-dir or remove stale '
                'genome/downstream checkpoints explicitly')

    def create_checkpoint(self, step: str):
        """Create a checkpoint file for a completed step."""
        Path(os.path.join(self.output_dir, self.steps[step])).touch()

    def check_checkpoint(self, step: str) -> bool:
        """Check if a step's checkpoint exists."""
        candidates = [self.steps[step]]
        if step in self.legacy_steps:
            candidates.append(self.legacy_steps[step])
        exists = any(os.path.exists(os.path.join(self.output_dir, name))
                     for name in candidates)
        if exists:
            logger.info(f"{step}: skipped (checkpoint exists)")
        return exists

    def run_cmd(self, cmd: str, workdir: Optional[str] = None,
                env: Optional[Dict[str, str]] = None,
                stream: bool = False) -> subprocess.CompletedProcess:
        """Run shell command with error handling and logging."""
        start_time = time.time()
        label = _cmd_label(cmd)

        try:
            logger.debug(f"Command: {cmd}")
            if stream:
                proc = subprocess.Popen(
                    cmd, shell=True, stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT, encoding='utf-8',
                    cwd=workdir, env=env)
                tail = []
                for line in proc.stdout:
                    message = line.rstrip()
                    if message:
                        logger.info(f"  {message}")
                        tail.append(message)
                        tail = tail[-20:]
                returncode = proc.wait()
                proc.stdout.close()
                if returncode:
                    raise subprocess.CalledProcessError(
                        returncode, cmd, stderr='\n'.join(tail))
                duration = time.time() - start_time
                logger.info(f"  {label} done ({duration:.0f}s)")
                return subprocess.CompletedProcess(cmd, returncode)

            result = subprocess.run(
                cmd,
                shell=True,
                check=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                encoding='utf-8',
                cwd=workdir,
                env=env
            )

            duration = time.time() - start_time
            if duration >= 5:
                logger.info(f"  {label} done ({duration:.0f}s)")
            return result

        except subprocess.CalledProcessError as e:
            duration = time.time() - start_time
            # Extract last meaningful error lines from stderr
            err_lines = [l for l in (e.stderr or '').strip().splitlines()
                         if l.strip() and '[INFO]' not in l]
            err_tail = '\n'.join(err_lines[-5:]) if err_lines else e.stderr
            logger.error(f"{label} failed ({duration:.0f}s)\n{err_tail}")
            raise

    def process_genome(self):
        """Step 1: Process genome and VCF files if provided."""
        if self.check_checkpoint('genome'):
            if self.gfa_file:
                self._validate_gfa_fingerprint()
            self.genome_file = self.processed_genome
            return

        genome_dir = os.path.join(self.output_dir, DIR_GENOME)
        processed_genome = os.path.join(genome_dir, 'genome.fa')
        os.makedirs(genome_dir, exist_ok=True)

        if self.original_genome_file:
            # Standard mode: use provided genome
            self.prepare_genome_file()

            if self.vcf_dir:
                combined_input = os.path.join(genome_dir, 'combined_input.fa')
                # Resume: VCF processing can be slow on large SV sets; if it already
                # completed (vcf.ok) and the combined input is present, reuse it instead
                # of re-running when a later genome step failed on a previous attempt.
                if self.check_checkpoint('vcf') and os.path.exists(combined_input):
                    logger.info("VCF processing already completed, using cached combined input...")
                    self.genome_file = combined_input
                else:
                    logger.info("Processing VCF files...")
                    vcf_processor = VCFProcessor(
                        vcf_dir=self.vcf_dir,
                        output_dir=genome_dir,
                        total_threads=self.threads
                    )
                    try:
                        vcf_sequences = vcf_processor.process_all_vcfs()
                        self.run_cmd(
                            f"cat {q(vcf_sequences)} {q(self.genome_file)} > {q(combined_input)}"
                        )
                        self.genome_file = combined_input
                        self.create_checkpoint('vcf')
                    except Exception as e:
                        logger.error(f"VCF processing failed: {e}")
                        raise

            logger.info("Processing genome...")
            self.process_single_genome(processed_genome)

            # PAF enrichment: append non-reference TE insertions to genome
            if self.paf_file:
                logger.info("PAF enrichment starting...")
                paf_work = os.path.join(genome_dir, 'paf_enrichment')
                os.makedirs(paf_work, exist_ok=True)
                try:
                    combined_fasta = self._prepare_paf_fasta(paf_work)
                    paf_proc = PAFProcessor(
                        paf_file=self.paf_file,
                        paf_fasta=combined_fasta,
                        output_dir=paf_work,
                        reference_genome=processed_genome,
                        threads=self.threads,
                        mapping_file=self.paf_mapping,
                        reference_seqnames=set(read_fasta_seqnames(
                            self.original_genome_file))
                    )
                    scaffold_path = paf_proc.process()
                    n_scaffolds = count_fasta_sequences(scaffold_path)
                    if n_scaffolds > 0:
                        with open(processed_genome, 'rb') as check:
                            check.seek(0, 2)
                            if check.tell() > 0:
                                check.seek(-1, 2)
                                if check.read(1) != b'\n':
                                    with open(processed_genome, 'ab') as fix:
                                        fix.write(b'\n')
                        with open(processed_genome, 'ab') as out:
                            with open(scaffold_path, 'rb') as inp:
                                shutil.copyfileobj(inp, out)
                        self.run_cmd(f"samtools faidx {q(processed_genome)}")
                        self.run_cmd(f"{q(os.path.join(BIN_DIR, 'index'))} {q(processed_genome)}")
                        logger.info(f"PAF enrichment: {n_scaffolds} scaffold(s) "
                                    f"appended to genome")
                    else:
                        logger.info("PAF enrichment: no candidates passed filters")
                except Exception as e:
                    logger.error(f"PAF enrichment failed: {e}")
                    raise

            # GFA enrichment: append graph-derived locus alleles.  Failures
            # are fatal by default; silently continuing would produce a library
            # that appears complete while omitting the pangenome contribution.
            if self.gfa_file:
                logger.info("GFA enrichment starting...")
                gfa_work = os.path.join(genome_dir, 'gfa_enrichment')
                os.makedirs(gfa_work, exist_ok=True)
                gfa_proc = GfaProcessor(
                    gfa_file=self.gfa_file,
                    output_dir=gfa_work,
                    reference_genome=processed_genome,
                    threads=self.threads,
                    gfa_ref=self.gfa_ref,
                    gfa_mode=self.gfa_mode,
                    window_overlap=self.gfa_window_overlap,
                    spacer_length=self.gfa_spacer_length,
                    keep_intermediates=self.gfa_keep_intermediates,
                    gfa_gaf=self.gfa_gaf,
                    gfa_gaf_fasta=self.gfa_gaf_fasta,
                    gfa_gaf_min_mapq=self.gfa_gaf_min_mapq,
                    gfa_gaf_min_identity=self.gfa_gaf_min_identity
                )
                scaffold_path = gfa_proc.process()
                n_scaffolds = count_fasta_sequences(scaffold_path)
                if n_scaffolds > 0:
                    with open(processed_genome, 'rb') as check:
                        check.seek(0, 2)
                        if check.tell() > 0:
                            check.seek(-1, 2)
                            if check.read(1) != b'\n':
                                with open(processed_genome, 'ab') as fix:
                                    fix.write(b'\n')
                    with open(processed_genome, 'ab') as out:
                        with open(scaffold_path, 'rb') as inp:
                            shutil.copyfileobj(inp, out)
                    self.run_cmd(f"samtools faidx {q(processed_genome)}")
                    self.run_cmd(
                        f"{q(os.path.join(BIN_DIR, 'index'))} "
                        f"{q(processed_genome)}")
                    logger.info(
                        f"GFA enrichment: {n_scaffolds} candidate record(s) "
                        f"appended to genome")
                else:
                    logger.info("GFA enrichment: no candidates passed filters")


        elif self.paf_file:
            # Reference-free PAF mode: construct genome from assemblies
            logger.info("Reference-free PAF mode: constructing genome from assemblies")
            paf_work = os.path.join(genome_dir, 'paf_enrichment')
            os.makedirs(paf_work, exist_ok=True)

            combined_fasta = self._prepare_paf_fasta(paf_work)
            paf_proc = PAFProcessor(
                paf_file=self.paf_file,
                paf_fasta=combined_fasta,
                output_dir=paf_work,
                reference_genome=None,
                threads=self.threads,
                mapping_file=self.paf_mapping,
                assembly_fastas=self.prepared_paf_fasta_files
            )
            pan_genome_path = paf_proc.process()

            n_seqs = count_fasta_sequences(pan_genome_path)
            if n_seqs == 0:
                raise RuntimeError(
                    "PAF processing produced no sequences — "
                    "check PAF file and assembly FASTAs")
            logger.info(f"Pan-genome from PAF: {n_seqs} sequences")

            self.genome_file = pan_genome_path
            logger.info("Processing genome...")
            self.process_single_genome(processed_genome)

        elif self.gfa_file:
            # Reference-free GFA mode: reconstruct genome from GFA graph
            logger.info("Reference-free GFA mode: constructing genome from GFA graph")
            gfa_work = os.path.join(genome_dir, 'gfa_enrichment')
            os.makedirs(gfa_work, exist_ok=True)

            gfa_proc = GfaProcessor(
                gfa_file=self.gfa_file,
                output_dir=gfa_work,
                reference_genome=None,
                threads=self.threads,
                gfa_ref=self.gfa_ref,
                gfa_mode=self.gfa_mode,
                window_overlap=self.gfa_window_overlap,
                spacer_length=self.gfa_spacer_length,
                keep_intermediates=self.gfa_keep_intermediates,
            gfa_gaf=self.gfa_gaf,
            gfa_gaf_fasta=self.gfa_gaf_fasta,
            gfa_gaf_min_mapq=self.gfa_gaf_min_mapq,
            gfa_gaf_min_identity=self.gfa_gaf_min_identity
            )
            pan_genome_path = gfa_proc.process()

            n_seqs = count_fasta_sequences(pan_genome_path)
            if n_seqs == 0:
                raise RuntimeError(
                    "GFA processing produced no sequences — "
                    "check GFA file format and content")
            logger.info(f"Pan-genome from GFA: {n_seqs} sequences")

            self.genome_file = pan_genome_path
            logger.info("Processing genome...")
            self.process_single_genome(processed_genome)

        else:
            raise RuntimeError("No genome source: provide --genome, --paf, or --gfa")

        self.genome_file = processed_genome
        self._write_gfa_fingerprint()
        self.create_checkpoint('genome')
        logger.info("Genome ready")

    def process_single_genome(self, output_file: str):
        """Process a single genome file."""
        self.run_cmd(
            f"{q(os.path.join(BIN_DIR, 'clean_seq_fast'))} {q(self.genome_file)} {q(output_file)}"
        )
        self.run_cmd(f"samtools faidx {q(output_file)}")
        self.run_cmd(f"{q(os.path.join(BIN_DIR, 'index'))} {q(output_file)}")

    def process_ltr(self):
        """Process LTRs using allocated threads."""
        if self.check_checkpoint('ltr'):
            return

        logger.info(f"LTR detection starting (threads={self.ltr_threads})")

        genome_file = os.path.join(self.output_dir, DIR_GENOME, 'genome.fa')
        if not os.path.exists(genome_file):
            raise FileNotFoundError(f"Processed genome not found: {genome_file}")

        if not os.path.exists(f"{genome_file}.fai"):
            self.run_cmd(f"samtools faidx {q(genome_file)}")

        self.run_cmd(
            f"{q(os.path.join(BIN_DIR, 'LTR_detect'))} {q(genome_file)} "
            f"{self.ltr_threads} {q(self.output_dir)}"
        )
        self.build_ltr_consensus()

        self.create_checkpoint('ltr')
        logger.info("LTR detection done")

    def build_ltr_consensus(self):
        """Build LTR consensus library from Look4LTRs .rtr output."""
        look4ltrs_dir = os.path.join(self.output_dir, "Look4LTRs")
        genome_file = os.path.join(self.output_dir, DIR_GENOME, 'genome.fa')

        build_script = resolve_ltr_library_builder()

        rtr_files = []
        for root, _, files in os.walk(look4ltrs_dir):
            for fname in files:
                if fname.endswith('.rtr'):
                    rtr_files.append(os.path.join(root, fname))
        rtr_files.sort()

        if not rtr_files:
            logger.warning("No .rtr files found, skipping LTR consensus")
            return

        logger.info(f"Building LTR consensus ({len(rtr_files)} .rtr files)")

        lib_dir = os.path.join(look4ltrs_dir, 'consensus_lib')
        os.makedirs(lib_dir, exist_ok=True)

        cmd = (f"python3 {q(build_script)} "
               f"--rtr {' '.join(q(path) for path in rtr_files)} "
               f"--genome {q(genome_file)} "
               f"--output {q(lib_dir)} "
               f"--threads {self.ltr_threads}")
        self.run_cmd(cmd, stream=True)

        final_lib = os.path.join(lib_dir, 'ltr_library.fa')
        if os.path.exists(final_lib):
            count = count_fasta_sequences(final_lib)
            logger.info(f"LTR library: {count} families")

    def process_mdl_repeat(self):
        """Process mdl-repeat with allocated threads."""
        if self.check_checkpoint('mdl_repeat'):
            return

        logger.info(f"mdl-repeat starting (threads={self.mdl_threads})")
        mdl_dir = self.stage_dir(DIR_MDL_REPEAT, DIR_MDL_REPEAT_LEGACY)
        tmp_dir = os.path.join(mdl_dir, 'tmp')
        os.makedirs(tmp_dir, exist_ok=True)
        processed_genome = os.path.join(self.output_dir, DIR_GENOME, 'genome.fa')
        cmd = " ".join([
            q(os.path.join(BIN_DIR, "build_mdl")),
            "--genome", q(processed_genome),
            "--threads", str(self.mdl_threads),
            "--tmp-dir", q(tmp_dir),
            "--work-dir", q(mdl_dir),
        ])

        self.run_cmd(cmd, mdl_dir)
        self.create_checkpoint('mdl_repeat')
        logger.info("mdl-repeat done")

    def find_mdl_repeat_for_dfam(self) -> Optional[str]:
        """Return the best mdl-repeat FASTA library for hmmbuild → dtr --dfam-hmm.

        Prefers consensus_masking.fa (T1+T2, high+medium confidence) for HMM
        quality; falls back to wider/lower-confidence libraries only if missing.
        """
        mdl_dir = self.stage_dir(DIR_MDL_REPEAT, DIR_MDL_REPEAT_LEGACY)
        candidates = [
            os.path.join(mdl_dir, 'refiner_output', 'consensus_masking.fa'),
            os.path.join(mdl_dir, 'refiner_output', 'phase3_analysis_library.fa'),
            os.path.join(mdl_dir, FILE_CONSENSUS),
            os.path.join(mdl_dir, FILE_CONSENSUS_LEGACY),
        ]
        return next((p for p in candidates
                     if os.path.exists(p) and os.path.getsize(p) > 0), None)

    def build_dfam_hmm_from_consensus(self, fa_in: str, hmm_out: str,
                                       work_dir: str) -> bool:
        """Build a multi-HMM bundle from a FASTA of consensus sequences.

        Each consensus is emitted as its own single-sequence Stockholm block,
        then a single hmmbuild call writes one HMM per block, all concatenated
        into hmm_out. Returns True if hmm_out exists and is non-empty.
        """
        sto_path = os.path.join(work_dir, "dfam_seed.sto")
        n_blocks = 0
        with open(fa_in) as fin, open(sto_path, 'w') as fout:
            name, chunks = None, []

            def _flush() -> int:
                if not name or not chunks:
                    return 0
                seq = ''.join(chunks)
                if len(seq) < 30:  # too short for hmmbuild to model usefully
                    return 0
                fout.write("# STOCKHOLM 1.0\n")
                fout.write(f"#=GF ID {name}\n")
                fout.write(f"{name}    {seq}\n//\n")
                return 1

            for raw in fin:
                line = raw.rstrip()
                if line.startswith('>'):
                    n_blocks += _flush()
                    # First whitespace-token; sanitize for Stockholm
                    tok = line[1:].split()[0] if len(line) > 1 else ""
                    name = tok.replace(' ', '_').replace('\t', '_') or None
                    chunks = []
                else:
                    chunks.append(line)
            n_blocks += _flush()

        if n_blocks == 0:
            logger.warning(f"No usable consensus sequences in {fa_in} for HMM build")
            try:
                os.remove(sto_path)
            except OSError:
                pass
            return False

        try:
            self.run_cmd(
                f"hmmbuild --dna --cpu {self.threads} "
                f"{q(hmm_out)} {q(sto_path)}",
                work_dir
            )
        finally:
            try:
                os.remove(sto_path)
            except OSError:
                pass

        return os.path.exists(hmm_out) and os.path.getsize(hmm_out) > 0

    def get_genome_size_bp(self) -> int:
        """Total genome size in bp from the .fai of the processed genome."""
        fai = (self.processed_genome or '') + '.fai'
        if not fai or not os.path.exists(fai):
            return 0
        total = 0
        with open(fai) as f:
            for line in f:
                parts = line.split('\t')
                if len(parts) >= 2:
                    try:
                        total += int(parts[1])
                    except ValueError:
                        continue
        return total

    @staticmethod
    def choose_te_looker_min_count(genome_bp: int) -> int:
        """Pick te-discover --min-count (seed = canonical 16-mer occurring >=C times)
        by genome size. dtr's built-in default is 20, which is an order of magnitude
        BELOW the >=200 validated on TAIR10 (135 Mb) and far too permissive on a
        multi-Gb genome: it admits a huge spurious low-copy seed set, inflating the
        family count. Background k-mer collisions grow with genome size, so the seed
        floor must rise with it.

        XS  (<300 Mb)        : 50
        S   (300 Mb – 1 Gb)  : 100
        M   (1 Gb – 3 Gb)    : 200   (maize-scale)
        L   (3 Gb – 10 Gb)   : 300
        XL  (>10 Gb)         : 500
        """
        if genome_bp <= 0:
            return 50
        if genome_bp < 300 * 10**6:
            return 50
        if genome_bp < 1 * 10**9:
            return 100
        if genome_bp < 3 * 10**9:
            return 200
        if genome_bp < 10 * 10**9:
            return 300
        return 500

    @staticmethod
    def choose_te_looker_window_stride(genome_bp: int) -> int:
        """Pick --window-stride by SCALABILITY_STRATEGY.md tier.

        XS  (<100 Mb)        : 50
        S/M (100 Mb – 3 Gb)  : 100  (default; mammal-scale)
        L   (3 Gb – 10 Gb)   : 200
        XL  (10 Gb – 30 Gb)  : 500
        XXL (>30 Gb)         : 1000
        """
        if genome_bp <= 0:
            return 100
        if genome_bp < 100 * 10**6:
            return 50
        if genome_bp < 3 * 10**9:
            return 100
        if genome_bp < 10 * 10**9:
            return 200
        if genome_bp < 30 * 10**9:
            return 500
        return 1000

    def resolve_te_looker_bin(self) -> str:
        """Resolve the dtr binary used for the TE-looker step."""
        candidates = []
        if self.te_looker_bin:
            candidates.append(self.te_looker_bin)
        env_bin = os.environ.get('TE_LOOKER_BIN')
        if env_bin:
            candidates.append(env_bin)
        path_bin = shutil.which('dtr')
        if path_bin:
            candidates.append(path_bin)
        # Fallback: te-looker dtr shipped alongside the other detectors in bin/
        candidates.append(os.path.join(BIN_DIR, 'dtr'))
        for candidate in candidates:
            if candidate and os.path.exists(candidate) and os.access(candidate, os.X_OK):
                return os.path.abspath(candidate)

        raise FileNotFoundError(
            'te-looker dtr binary not found. Set TE_LOOKER_BIN, add dtr to PATH, '
            'or provide --te-looker-bin.'
        )

    def probe_dtr_capabilities(self, dtr_bin: str, env: Dict[str, str]) -> Dict:
        """Determine what the installed dtr actually honours.

        te-looker <=0.3.0 has no --version (anything but `run` prints usage and exits 2)
        and *discards* --window-stride while silently defaulting the real scaling knob
        --w to 1; 0.3.1 adds --version and releases the duplicate k-mer buffer. Probing
        rather than assuming keeps Pan_TE correct against both, which matters because
        the binary normally comes from bioconda and lags this repo.
        """
        if self._dtr_caps is not None:
            return self._dtr_caps

        version = None
        try:
            proc = subprocess.run([dtr_bin, '--version'], capture_output=True,
                                  encoding='utf-8', env=env, timeout=30)
            if proc.returncode == 0:
                match = re.search(r'(\d+)\.(\d+)\.(\d+)', (proc.stdout or '') + (proc.stderr or ''))
                if match:
                    version = tuple(int(g) for g in match.groups())
        except (OSError, subprocess.SubprocessError):
            version = None

        double_copy = version is None or version < TE_LOOKER_SINGLE_COPY_VERSION
        self._dtr_caps = {
            'version': version,
            # --w is read by every dtr generation; unknown flags are ignored by the
            # legacy parser, so passing it explicitly is safe either way.
            'supports_w': True,
            'stride_effective': version is not None and version >= TE_LOOKER_STRIDE_VERSION,
            'final_gated': False,
            'double_copy': double_copy,
        }
        # This feature has no safe version-only threshold because local dtr builds may
        # carry the same package version with different staged subcommands. Probe the
        # command's explicit help contract instead of guessing.
        try:
            help_proc = subprocess.run([dtr_bin, 'run', '--help'], capture_output=True,
                                       encoding='utf-8', env=env, timeout=30)
            help_text = (help_proc.stdout or '') + (help_proc.stderr or '')
            self._dtr_caps['final_gated'] = (help_proc.returncode == 0
                                              and '--final-gated' in help_text)
        except (OSError, subprocess.SubprocessError):
            pass
        label = '.'.join(str(v) for v in version) if version else 'pre-0.3.1 (no --version)'
        logger.info(f"dtr capability probe: version {label}, "
                    f"seed-harvest holds {'two copies' if double_copy else 'one copy'}, "
                    f"final-gated={'yes' if self._dtr_caps['final_gated'] else 'no'}")
        return self._dtr_caps

    def check_te_looker_memory(self, genome_bp: int, w: int, double_copy: bool) -> None:
        """Abort before the multi-hour dtr step if it cannot fit in available memory.

        Insufficient memory is a solvable blocker (a larger node, a bigger --mem), so
        Pan_TE refuses to quietly subsample its way around it: silently changing w would
        make the resulting library depend on which machine happened to run it. The user
        is told exactly what is needed and given the explicit opt-in instead.
        """
        if genome_bp <= 0:
            logger.warning("Genome size unknown; skipping te-looker memory feasibility check")
            return

        required = estimate_te_looker_peak_bytes(genome_bp, w, double_copy)
        limit = detect_memory_limit(self.memory_limit_mb)
        mode = f"w={w} (exact k-mer)" if w <= 1 else f"w={w} (minimizer, ~{minimizer_density(w):.3f} density)"
        logger.info(f"te-looker memory estimate: genome {genome_bp/1e9:.2f} Gb, {mode} "
                    f"→ peak ~{human_bytes(required)}")

        if limit is None:
            logger.warning("Could not determine any memory limit (no /proc/meminfo, cgroup "
                           "or SLURM allocation); proceeding without a feasibility check")
            return

        logger.info(f"Detected memory ceiling: {human_bytes(limit['bytes'])} "
                    f"(from {limit['source']})")
        if required <= limit['bytes']:
            return

        suggested = w
        while suggested < 64 and estimate_te_looker_peak_bytes(
                genome_bp, suggested, double_copy) > limit['bytes']:
            suggested += 1
        derived = self.derive_min_count(genome_bp, suggested)
        detail = '\n'.join(f"    {src}: {human_bytes(val)}"
                           for src, val in sorted(limit['all'].items(),
                                                  key=lambda kv: kv[1]))
        raise MemoryError(
            "te-looker (dtr) cannot run in the memory available to this job.\n"
            f"  genome              {genome_bp/1e9:.2f} Gb\n"
            f"  mode                {mode}\n"
            f"  estimated peak      {human_bytes(required)}\n"
            f"  available           {human_bytes(limit['bytes'])}  (from {limit['source']})\n"
            f"{detail}\n"
            "Fix (pick one):\n"
            f"  1) give the job more memory (>= {human_bytes(required)}), e.g. a larger\n"
            "     node or a higher --mem / -M value;\n"
            f"  2) opt into k-mer subsampling, which CHANGES the seed set:\n"
            f"       --te-looker-w {suggested}   "
            f"(estimated peak {human_bytes(estimate_te_looker_peak_bytes(genome_bp, suggested, double_copy))}, "
            f"--min-count becomes {derived})\n"
            "Aborting before any long-running step."
        )

    def derive_min_count(self, genome_bp: int, w: int) -> int:
        """--min-count for a given w.

        choose_te_looker_min_count is calibrated for w=1 (every occurrence counted).
        Under minimizer subsampling only ~2/(w+1) of a family's occurrences are emitted,
        so an unscaled floor would reject every real family and silently return nothing.
        """
        base = self.choose_te_looker_min_count(genome_bp)
        if w <= 1:
            return base
        return max(TE_LOOKER_MIN_COPIES, int(round(base * minimizer_density(w))))

    def te_looker_env(self, dtr_bin: str) -> Dict[str, str]:
        """Build an environment with local tool paths needed by dtr."""
        env = os.environ.copy()
        # Rust gives spawned threads a 2 MiB stack by default (only the main thread gets
        # ulimit -s), and te-looker does not set an explicit rayon stack_size. Raising it
        # here is free and removes a whole class of "stack overflow" aborts in the
        # parallel seed harvest on large genomes.
        env.setdefault('RUST_MIN_STACK', str(64 * 1024 * 1024))
        path_parts = [os.path.dirname(dtr_bin)]
        for var in ('FASTGA_BIN', 'ABPOA_BIN', 'TE_LOOKER_TOOL_PATH'):
            value = env.get(var)
            if value:
                path_parts.extend(value.split(os.pathsep))
        existing = [p for p in path_parts if p and os.path.isdir(p)]
        if existing:
            env['PATH'] = os.pathsep.join(existing + [env.get('PATH', '')])
        return env

    @staticmethod
    def _fasta_summary(path: str) -> Dict[str, object]:
        """Return content-addressed FASTA statistics for provenance."""
        digest = hashlib.sha256()
        count = bases = 0
        with open(path, 'rb') as handle:
            for raw in handle:
                digest.update(raw)
                if raw.startswith(b'>'):
                    count += 1
                else:
                    bases += len(raw.strip())
        return {'path': os.path.abspath(path), 'families': count,
                'bases': bases, 'sha256': digest.hexdigest()}

    @staticmethod
    def _load_json_object(path: str) -> Optional[dict]:
        try:
            with open(path) as handle:
                value = json.load(handle)
            return value if isinstance(value, dict) else None
        except (OSError, ValueError, TypeError):
            return None

    def _is_gated_dtr_output(self, provenance_path: str) -> bool:
        """Trust dtr only when it declares the explicit final-output contract."""
        payload = self._load_json_object(provenance_path)
        if payload is None:
            if os.path.exists(provenance_path):
                logger.warning("Ignoring unreadable dtr provenance: %s", provenance_path)
            return False
        valid = (payload.get('contract') == TE_LOOKER_GATED_CONTRACT
                 and payload.get('mode') == 'gated'
                 and payload.get('final_library') == 'families.fasta')
        if not valid:
            logger.warning("dtr provenance does not declare %s; applying Pan_TE discovery gate",
                           TE_LOOKER_GATED_CONTRACT)
        return valid

    @staticmethod
    def _write_te_looker_handoff(path: str, payload: Dict[str, object]) -> None:
        """Atomically write Pan_TE's stable TE-looker handoff provenance."""
        temp_path = path + '.tmp'
        with open(temp_path, 'w') as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write('\n')
        os.replace(temp_path, path)

    def _gate_and_merge_te_looker(self, families_fasta: str, work_dir: str):
        """Gate discovery dtr families and return (library_path, audit)."""
        gated = os.path.join(work_dir, 'discovery_gated.fa')
        merged = os.path.join(work_dir, 'discovery_merged.fa')
        kept = dropped = missing_members = 0
        header = None
        seq_parts: list = []

        def _flush(fout):
            nonlocal kept, dropped, missing_members
            if header is None:
                return
            seq = ''.join(seq_parts)
            match = re.search(r'members=(\d+)', header)
            if match is None:
                members = TE_LOOKER_MIN_COPIES
                missing_members += 1
            else:
                members = int(match.group(1))
            if members >= TE_LOOKER_MIN_COPIES and len(seq) >= TE_LOOKER_MIN_LEN:
                fout.write(header + '\n')
                for i in range(0, len(seq), 80):
                    fout.write(seq[i:i + 80] + '\n')
                kept += 1
            else:
                dropped += 1

        with open(families_fasta) as fin, open(gated, 'w') as fout:
            for line in fin:
                if line.startswith('>'):
                    _flush(fout)
                    header, seq_parts = line.rstrip('\n'), []
                else:
                    seq_parts.append(line.strip())
            _flush(fout)
        logger.info("TE-looker gate (members>=%d, len>=%dbp): kept %d, dropped %d",
                    TE_LOOKER_MIN_COPIES, TE_LOOKER_MIN_LEN, kept, dropped)
        audit = {
            'mode': 'discovery_host_gate',
            'input': self._fasta_summary(families_fasta),
            'copy_length_gate': {
                'min_members': TE_LOOKER_MIN_COPIES,
                'min_length_bp': TE_LOOKER_MIN_LEN,
                'kept': kept, 'dropped': dropped,
                'headers_missing_members_assumed_minimum': missing_members,
            },
            'merge': {'tool': 'cd-hit-est', 'identity': TE_LOOKER_MERGE_IDENTITY,
                      'shorter_coverage': 0.6, 'both_strands': True},
        }
        if kept == 0:
            logger.warning("TE-looker gate left no families; merged library is empty")
            Path(merged).touch()
        else:
            self.run_cmd(
                f"cd-hit-est -i {q(gated)} -o {q(merged)} "
                f"-c {TE_LOOKER_MERGE_IDENTITY} -aS 0.6 -n 5 -r 1 -g 1 -d 0 "
                f"-M 0 -T {self.threads}", work_dir)
        audit['gated'] = self._fasta_summary(gated)
        audit['output'] = self._fasta_summary(merged)
        return merged, audit

    def process_te_looker(self):
        """Step 4: Process TE-looker."""
        if self.check_checkpoint('te_looker'):
            return

        logger.info("TE-looker starting")
        te_stage_dir = self.stage_dir(DIR_TE_LOOKER, DIR_TE_LOOKER_LEGACY)
        te_run_dir = os.path.join(te_stage_dir, 'run')
        os.makedirs(te_run_dir, exist_ok=True)

        te_looker_genome = self.processed_genome
        logger.info(f"Using processed genome for TE-looker: {te_looker_genome}")

        # Resume convenience: dtr discovery (te-discover + te-refine + the expensive
        # mdl→HMM seed build) is the multi-hour step. If a families.fasta already exists
        # from a prior run, skip dtr entirely and only re-apply the gate/merge below.
        # Delete te-looker/run/families.fasta to force a full re-discovery.
        te_looker_families = os.path.join(te_run_dir, 'families.fasta')
        need_discovery = not (os.path.exists(te_looker_families)
                              and os.path.getsize(te_looker_families) > 0)
        if self.te_looker_final_gated and not need_discovery:
            existing_contract = self._is_gated_dtr_output(
                os.path.join(te_run_dir, TE_LOOKER_PROVENANCE))
            if not existing_contract:
                need_discovery = True
                logger.info("TE-looker final-gated requested; existing discovery output "
                            "has no final contract, so dtr will regenerate it")
        if not need_discovery:
            logger.info(f"TE-looker resume: reusing existing {te_looker_families}; "
                        f"skipping dtr discovery, re-applying gate only")

        dtr_bin = self.resolve_te_looker_bin()
        dtr_env = self.te_looker_env(dtr_bin)
        caps = self.probe_dtr_capabilities(dtr_bin, dtr_env)
        extra_tokens = shlex.split(self.te_looker_extra_args)
        final_requested = self.te_looker_final_gated or '--final-gated' in extra_tokens
        if final_requested and not caps['final_gated']:
            raise RuntimeError(
                'The selected dtr does not advertise --final-gated; rebuild the staged '
                'te-looker dtr or omit --te-looker-final-gated to use the host fallback.'
            )
        cmd_parts = [
            q(dtr_bin),
            'run',
            '--genome', q(te_looker_genome),
            '--out', q(te_run_dir),
            '--threads', str(self.threads),
        ]
        if final_requested and '--final-gated' not in extra_tokens:
            cmd_parts.append('--final-gated')

        # Auto-feed mdl-repeat consensus → Track 1 nhmmer HMM library.
        # This replaces the older --track2-library seeding: HMM profile search
        # is the right vehicle for "known-family fast detection" so windows
        # without Track 1 hits leave Tracks 2/3 free for de novo discovery of
        # the divergent / fragmented TEs that TE-looker is designed for.
        if (need_discovery
                and '--dfam-hmm' not in extra_tokens
                and '--seed-from-repeatscout' not in extra_tokens):
            mdl_fa = self.find_mdl_repeat_for_dfam()
            if mdl_fa:
                dfam_hmm = os.path.join(te_stage_dir, 'mdl_repeat_seed.hmm')
                # Resubmitting a job that died inside dtr must not pay for this again:
                # the seed depends only on the (already checkpointed) mdl-repeat output,
                # so an existing non-empty bundle newer than its input is reused as-is.
                if (os.path.exists(dfam_hmm) and os.path.getsize(dfam_hmm) > 0
                        and os.path.getmtime(dfam_hmm) >= os.path.getmtime(mdl_fa)):
                    logger.info(f"Track 1 HMM seed reused from previous run: {dfam_hmm}")
                    ok = True
                else:
                    logger.info(f"Building Track 1 HMM seed from mdl-repeat consensus: {mdl_fa}")
                    ok = self.build_dfam_hmm_from_consensus(mdl_fa, dfam_hmm, te_stage_dir)
                if ok:
                    logger.info(f"Track 1 HMM seed ready: {dfam_hmm}")
                    # dtr ignores --dfam-hmm unless --enable-known-hmm-discovery
                    # is also set (the latter is a master switch that gates the
                    # legacy library-seeded mode). Pass both so the mdl-repeat
                    # HMM actually reaches Track 1 nhmmer.
                    cmd_parts.extend([
                        '--dfam-hmm', q(dfam_hmm),
                        '--enable-known-hmm-discovery',
                    ])
                else:
                    logger.warning(
                        "hmmbuild produced no usable HMMs; Track 1 will run "
                        "without a seed library (de novo Tracks 2/3 only)"
                    )
            else:
                logger.warning(
                    "No mdl-repeat consensus found for Track 1 HMM seeding; "
                    "Track 1 will run without a seed library"
                )

        genome_bp = self.get_genome_size_bp()

        # --w is the real memory/throughput lever (te_core::harvest emits every k-mer at
        # w=1, minimizers at ~2/(w+1) density above it). Pan_TE previously auto-scaled
        # --window-stride instead, which dtr accepts and then discards -- the run looked
        # scaled but was not. w stays at 1 unless the user explicitly opts in, because
        # subsampling changes the seed set and must never depend on the host's RAM.
        w = self.te_looker_w
        if '--w' in extra_tokens:
            try:
                w = max(1, int(extra_tokens[extra_tokens.index('--w') + 1]))
            except (IndexError, ValueError):
                pass
        elif w > 1:
            cmd_parts.extend(['--w', str(w)])

        if w > 1:
            logger.warning(
                f"te-discover minimizer subsampling ENABLED (--te-looker-w {w}): only "
                f"~{minimizer_density(w):.3f} of k-mer occurrences are emitted. This "
                f"changes the seed set relative to the default exact mode (w=1)."
            )

        if need_discovery:
            self.check_te_looker_memory(genome_bp, w, caps['double_copy'])

        # Auto-scale --min-count (seed occurrence floor) to genome size. dtr's
        # built-in default (20) over-seeds large genomes and inflates the family
        # count; this raises the floor with genome size (e.g. ~200 at maize scale).
        # Under w>1 the floor is re-derived, since counts are subsampled with the k-mers.
        if '--min-count' not in extra_tokens:
            min_count = self.derive_min_count(genome_bp, w)
            note = '' if w <= 1 else f" (re-derived for w={w} from {self.choose_te_looker_min_count(genome_bp)})"
            logger.info(
                f"Genome size {genome_bp/1e9:.2f} Gb → --min-count {min_count} (auto){note}"
            )
            cmd_parts.extend(['--min-count', str(min_count)])

        # --window-stride is only forwarded to a dtr that actually implements it; older
        # builds print a note and ignore it, which is how the inert knob went unnoticed.
        if caps['stride_effective'] and '--window-stride' not in extra_tokens:
            stride = self.choose_te_looker_window_stride(genome_bp)
            logger.info(
                f"Genome size {genome_bp/1e9:.2f} Gb → --window-stride {stride} (auto)"
            )
            cmd_parts.extend(['--window-stride', str(stride)])

        if need_discovery:
            if self.te_looker_extra_args:
                cmd_parts.append(self.te_looker_extra_args)
            result = self.run_cmd(' '.join(cmd_parts), te_stage_dir, env=dtr_env)
            # run_cmd only shows stderr when a command fails, so dtr's notices about
            # flags it accepted-but-ignored were invisible on success. Promote them:
            # an ignored knob must never again look like a working one.
            for line in (result.stderr or '').splitlines():
                stripped = line.strip()
                if stripped.startswith('[dtr]') and (
                        'note:' in stripped or 'not yet implemented' in stripped
                        or 'warning' in stripped.lower()):
                    logger.warning(f"dtr: {stripped[len('[dtr]'):].strip()}")
            if not os.path.exists(te_looker_families):
                raise FileNotFoundError(
                    f"TE-looker completed but required output is missing: {te_looker_families}"
                )

        # A bare provenance.json does not prove that a future dtr performed its
        # advertised final gates.  The explicit contract is the compatibility boundary.
        provenance = os.path.join(te_run_dir, TE_LOOKER_PROVENANCE)
        dtr_gated = self._is_gated_dtr_output(provenance)
        source_summary = self._fasta_summary(te_looker_families)
        stitch_audit = {'attempted': False, 'status': 'not_needed' if dtr_gated else 'not_available'}

        # Fragment-chain stitching is discovery-only. It is deliberately non-fatal: a
        # failed reconstruction must never fabricate a consensus or prevent the bounded
        # copy/length + redundancy gate from protecting the final library.
        disc_members_bed = os.path.join(te_run_dir, 'disc.members.bed')
        if (not dtr_gated and os.path.getsize(te_looker_families) > 0
                and os.path.exists(disc_members_bed)
                and os.path.getsize(disc_members_bed) > 0):
            stitch_audit = {'attempted': True, 'status': 'failed',
                            'members_bed': os.path.abspath(disc_members_bed)}
            try:
                import fragment_stitcher
                stitched_fa = os.path.join(te_run_dir, 'families_stitched.fasta')
                logger.info("TE-looker fragment-chain stitching (pre-gate)...")
                fragment_stitcher.stitch_te_looker(
                    te_looker_families, disc_members_bed, te_looker_genome, stitched_fa)
                if os.path.exists(stitched_fa) and os.path.getsize(stitched_fa) > 0:
                    stitch_audit.update({'status': 'used',
                                         'input': self._fasta_summary(te_looker_families),
                                         'output': self._fasta_summary(stitched_fa)})
                    te_looker_families = stitched_fa
                else:
                    stitch_audit['reason'] = 'no_nonempty_stitched_output'
            except Exception as exc:
                stitch_audit['reason'] = str(exc)
                logger.warning("TE-looker fragment stitching failed (continuing unstitched): %s", exc)

        final_consensus = os.path.join(te_stage_dir, FILE_CONSENSUS)
        legacy_consensus = os.path.join(te_stage_dir, FILE_CONSENSUS_LEGACY)
        handoff = {
            'schema': 'pan-te-te-looker-handoff-v1',
            'dtr_provenance_path': os.path.abspath(provenance),
            'dtr_declared_gated': dtr_gated,
            'discovery_source': source_summary,
            'stitch': stitch_audit,
        }
        if os.path.getsize(te_looker_families) == 0:
            Path(final_consensus).touch()
            handoff['mode'] = 'empty'
            logger.warning("TE-looker produced an empty families.fasta")
        elif dtr_gated:
            handoff['mode'] = 'gated_dtr'
            logger.info("TE-looker output declares %s; using dtr final library", TE_LOOKER_GATED_CONTRACT)
            shutil.copyfile(te_looker_families, final_consensus)
        else:
            handoff['mode'] = 'discovery_host_gate'
            raw_count = count_fasta_sequences(te_looker_families)
            logger.info("TE-looker output is discovery-grade; merging + gating %d families before Combine",
                        raw_count)
            merged, gate_audit = self._gate_and_merge_te_looker(te_looker_families, te_run_dir)
            handoff['gate'] = gate_audit
            if os.path.getsize(merged) > 0:
                shutil.copyfile(merged, final_consensus)
            else:
                Path(final_consensus).touch()
        shutil.copyfile(final_consensus, legacy_consensus)
        handoff['final_library'] = self._fasta_summary(final_consensus)
        handoff['sanity'] = {
            'max_families_per_mb': TE_LOOKER_SANITY_FAMILIES_PER_MB,
            'genome_mb': self.get_genome_size_bp() / 1e6,
        }
        self._write_te_looker_handoff(
            os.path.join(te_run_dir, TE_LOOKER_HANDOFF_PROVENANCE), handoff)

        count = count_fasta_sequences(final_consensus)
        logger.info(f"TE-looker consensus library: {count} families")

        # Sanity bound: the gate must collapse the discovery inflation. A surviving count
        # far above what a genome of this size can carry means the merge/gate failed —
        # fail loudly rather than ship a bloated library into Combine.
        genome_mb = self.get_genome_size_bp() / 1e6
        if genome_mb > 0 and count > genome_mb * TE_LOOKER_SANITY_FAMILIES_PER_MB:
            raise RuntimeError(
                f"TE-looker library has {count} families for a {genome_mb:.0f} Mb genome "
                f"(> {TE_LOOKER_SANITY_FAMILIES_PER_MB}/Mb); the merge/gate did not "
                f"collapse the discovery inflation. Refusing to pass a bloated library to "
                f"Combine — inspect {te_run_dir}."
            )

        self.create_checkpoint('te_looker')
        logger.info("TE-looker step done")

    def combine_results(self):
        """Step 5: Combine and classify results."""
        if self.check_checkpoint('combine'):
            return

        logger.info("Combining results")
        combine_dir = self.stage_dir(DIR_COMBINE, DIR_COMBINE_LEGACY)
        os.makedirs(combine_dir, exist_ok=True)

        # Collect mdl-repeat consensus
        mdl_dir = self.stage_dir(DIR_MDL_REPEAT, DIR_MDL_REPEAT_LEGACY)
        mdl_consensus_candidates = [
            os.path.join(mdl_dir, 'refiner_output', 'phase3_analysis_library.fa'),
            os.path.join(mdl_dir, FILE_CONSENSUS),
            os.path.join(mdl_dir, FILE_CONSENSUS_LEGACY),
        ]
        mdl_consensus = next((p for p in mdl_consensus_candidates
                              if os.path.exists(p) and os.path.getsize(p) > 0), None)
        if not mdl_consensus:
            raise FileNotFoundError("mdl-repeat consensus library not found")

        # Collect TE-looker consensus
        te_stage_dir = self.stage_dir(DIR_TE_LOOKER, DIR_TE_LOOKER_LEGACY)
        te_consensus_files = []

        for filename in (FILE_CONSENSUS, FILE_CONSENSUS_LEGACY):
            candidate = os.path.join(te_stage_dir, filename)
            if os.path.exists(candidate) and os.path.getsize(candidate) > 0:
                te_consensus_files.append(candidate)
                break

        # LTR consensus
        ltr_consensus_candidates = [
            os.path.join(self.output_dir, "Look4LTRs", "consensus_lib", "ltr_library.fa"),
            os.path.join(self.output_dir, "Look4LTRs", FILE_CONSENSUS_LEGACY),
        ]
        ltr_consensus = next((p for p in ltr_consensus_candidates
                              if os.path.exists(p) and os.path.getsize(p) > 0), None)
        if not ltr_consensus:
            raise FileNotFoundError("LTR consensus library not found")

        input_files = [ltr_consensus, mdl_consensus] + te_consensus_files

        if not te_consensus_files:
            logger.warning("No TE-looker consensus files found")

        logger.info(f"Merging {len(input_files)} sources "
                    f"(LTR + mdl-repeat + {len(te_consensus_files)} TE-looker)")
        combined_library = os.path.join(combine_dir, FILE_COMBINED_LIBRARY)
        te_library = os.path.join(combine_dir, FILE_TE_LIBRARY)
        legacy_combined_library = os.path.join(combine_dir, FILE_COMBINED_LIBRARY_LEGACY)
        legacy_te_library = os.path.join(combine_dir, FILE_TE_LIBRARY_LEGACY)
        quoted_inputs = " ".join(q(path) for path in input_files)
        self.run_cmd(
            f"cat {quoted_inputs} > {q(combined_library)}",
            combine_dir
        )
        shutil.copyfile(combined_library, legacy_combined_library)

        # Deduplication. Three upstream sources (LTR / mdl-repeat / TE-looker)
        # are each internally deduplicated/merged, so the final cross-library
        # merger uses a tighter identity threshold (0.9) to avoid collapsing
        # related-but-distinct families across detectors.
        logger.info("Deduplicating with cd-hit-est (identity 0.9)...")
        self.run_cmd(
            f"cd-hit-est "
            f"-i {q(combined_library)} -o {q(te_library)} "
            f"-c 0.9 -aS 0.8 -aL 0.8 -G 0 -n 8 -r 1 "
            f"-mask NX -M 0 -T {self.threads} -d 0",
            combine_dir
        )
        shutil.copyfile(te_library, legacy_te_library)

        raw_count = count_fasta_sequences(combined_library)
        final_count = count_fasta_sequences(te_library)
        logger.info(f"Dedup: {raw_count} -> {final_count} ({raw_count - final_count} removed)")

        # Classification
        if self.model_dir:
            logger.info("Classifying TEs...")
            self.run_cmd(
                f"{q(os.path.join(BIN_DIR, 'run_Classifier'))} {q(self.model_dir)} {self.threads}",
                combine_dir
            )

        self.create_checkpoint('combine')
        logger.info("Combine done")

    def annotate_gfa(self):
        """Project all supplied genome annotations onto GFA node coordinates."""
        if not self.anno_manifest:
            raise ValueError("--anno requires an all-genome --anno-manifest")

        anno_dir = os.path.join(self.output_dir, DIR_ANNO)
        annotator = GfaAnnotator(
            gfa_file=self.gfa_file,
            output_dir=anno_dir,
            annotation_manifest=self.anno_manifest,
            gfa_gaf=self.gfa_gaf,
            gfa_gaf_min_mapq=self.gfa_gaf_min_mapq,
            gfa_gaf_min_identity=self.gfa_gaf_min_identity,
            te_min_fraction=self.anno_te_min_fraction,
            partial_min_fraction=self.anno_partial_min_fraction,
        )
        result = annotator.annotate()
        self.create_checkpoint('anno')
        logger.info(f"GFA node annotation written to {result}")

    def run(self):
        """Run complete pipeline."""
        try:
            # Create output directory structure (deferred from __init__ so a failed
            # preflight leaves no partial work directory behind).
            self.setup_directories()

            if not self.check_checkpoint('genome'):
                self.process_genome()
            else:
                # Checkpoint exists — verify the processed genome is actually present
                if not os.path.exists(self.processed_genome):
                    logger.warning("Genome checkpoint exists but processed genome missing, re-running")
                    self.process_genome()
                else:
                    if self.gfa_file:
                        self._validate_gfa_fingerprint()
                    self.genome_file = self.processed_genome

            logger.info("Parallel detection: LTR + mdl-repeat")
            with ThreadPoolExecutor(max_workers=2) as executor:
                ltr_future = executor.submit(self.process_ltr)
                mdl_future = executor.submit(self.process_mdl_repeat)

                for future in [ltr_future, mdl_future]:
                    try:
                        future.result()
                    except Exception as e:
                        logger.error(f"Detection failed: {e}")
                        raise

            if not self.check_checkpoint('te_looker'):
                self.process_te_looker()

            if not self.check_checkpoint('combine'):
                self.combine_results()

            if self.anno_enabled:
                self.annotate_gfa()

        except Exception as e:
            logger.error(f"Pipeline failed: {e}")
            raise
        finally:
            self.cleanup_temp_files()

def main():
    """Main execution function."""
    try:
        args = parse_arguments()

        pipeline = PanTEPipeline(
            genome_file=args.genome,
            output_dir=args.out_dir,
            threads=args.threads,
            model_dir=args.model_dir,
            vcf_dir=args.vcf_dir,
            paf_file=args.paf,
            paf_fasta=args.paf_fasta,       # list from nargs='+'
            paf_mapping=args.paf_mapping,
            gfa_file=args.gfa,
            gfa_ref=args.gfa_ref,
            gfa_mode=args.gfa_mode,
            gfa_window_overlap=args.gfa_window_overlap,
            gfa_spacer_length=args.gfa_spacer_length,
            gfa_keep_intermediates=not args.gfa_clean_intermediates,
            gfa_gaf=args.gfa_gaf,
            gfa_gaf_fasta=args.gfa_gaf_fasta,
            gfa_gaf_min_mapq=args.gfa_gaf_min_mapq,
            gfa_gaf_min_identity=args.gfa_gaf_min_identity,
            anno=args.anno,
            anno_manifest=args.anno_manifest,
            anno_te_min_fraction=args.anno_te_min_fraction,
            anno_partial_min_fraction=args.anno_partial_min_fraction,
            te_looker_bin=args.te_looker_bin,
            te_looker_extra_args=args.te_looker_extra_args,
            te_looker_final_gated=args.te_looker_final_gated,
            te_looker_w=args.te_looker_w,
            memory_limit_mb=args.M
        )

        if args.M > 0:
            import resource
            resource.setrlimit(resource.RLIMIT_AS, (args.M * 1024 * 1024, -1))

        if args.anno_only:
            pipeline.setup_directories()
            pipeline.annotate_gfa()
            logger.info("GFA annotation-only run completed successfully")
            return

        # Verify the environment before any long-running step. Every dependency the
        # requested run will need is checked in one pass, so a missing tool or an
        # under-provisioned node fails in seconds with an actionable message instead of
        # aborting hours in.
        import preflight
        ok = preflight.run_preflight(pipeline, check_only=args.check_env)
        if args.check_env:
            sys.exit(0 if ok else 1)

        pipeline.run()
        logger.info("Pipeline completed successfully")

    except KeyboardInterrupt:
        logger.error("Interrupted by user")
        sys.exit(1)
    except Exception as e:
        logger.error(f"Pipeline failed: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
