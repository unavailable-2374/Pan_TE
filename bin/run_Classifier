#!/usr/bin/env bash

# Enable error handling
set -e
set -o pipefail

# Configuration
LOG_FILE="classifier.log"
TE_LIBRARY="raw_te_library.fa"
if [ ! -s "$TE_LIBRARY" ] && [ -s "raw_TEs.fa" ]; then
    TE_LIBRARY="raw_TEs.fa"
fi

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1" | tee -a "$LOG_FILE" >&2
    exit 1
}

# Check arguments
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    error "Usage: $0 <ClassifyTE_dir> [threads]"
fi

CLASSIFYTE_DIR="$1"
THREADS="${2:-$(nproc)}"
CLASSIFYTE_ENV_NAME="${CLASSIFYTE_ENV_NAME:-ClassifyTE_env}"

# Verify directory exists
if [ ! -d "$CLASSIFYTE_DIR" ]; then
    error "ClassifyTE directory not found: $CLASSIFYTE_DIR"
fi

# Auto-detect correct ClassifyTE root directory
# If user passed a subdirectory (e.g., .../ClassifyTE/models), walk up to find root
if [ ! -d "$CLASSIFYTE_DIR/features" ] || [ ! -d "$CLASSIFYTE_DIR/models" ]; then
    PARENT_DIR="$(dirname "$CLASSIFYTE_DIR")"
    if [ -d "$PARENT_DIR/features" ] && [ -d "$PARENT_DIR/models" ] && [ -d "$PARENT_DIR/nodes" ]; then
        log "Auto-corrected ClassifyTE path: $CLASSIFYTE_DIR -> $PARENT_DIR"
        CLASSIFYTE_DIR="$PARENT_DIR"
    fi
fi

log "Starting TE classification process"
log "ClassifyTE directory: $CLASSIFYTE_DIR"
log "Using $THREADS threads for classification"
log "Input TE library: $TE_LIBRARY"

if [ ! -s "$TE_LIBRARY" ]; then
    error "Input TE library not found or empty: raw_te_library.fa"
fi

# Resolve the isolated ClassifyTE environment without activating it. Calling
# `conda run` from an already-active main environment can execute that
# environment's compiler deactivation hooks with the wrong CONDA_PREFIX (for
# example, PGTA's gxx hook may look for a compiler under the Conda base prefix).
# Executing the target interpreter directly avoids that nested-activation
# failure while retaining ClassifyTE's pinned Python dependencies.
resolve_classifyte_prefix() {
    local conda_cmd=""
    local conda_base=""
    local candidate=""

    if [ -n "${CLASSIFYTE_ENV_PREFIX:-}" ]; then
        printf '%s\n' "$CLASSIFYTE_ENV_PREFIX"
        return 0
    fi

    if [ -n "${CONDA_EXE:-}" ] && [ -x "$CONDA_EXE" ]; then
        conda_cmd="$CONDA_EXE"
    elif command -v conda >/dev/null 2>&1; then
        conda_cmd="$(command -v conda)"
    else
        return 1
    fi

    conda_base="$("$conda_cmd" info --base 2>/dev/null)" || return 1
    candidate="$conda_base/envs/$CLASSIFYTE_ENV_NAME"
    if [ -x "$candidate/bin/python" ]; then
        printf '%s\n' "$candidate"
        return 0
    fi

    "$conda_cmd" env list 2>/dev/null \
        | awk -v env_name="$CLASSIFYTE_ENV_NAME" '$1 == env_name {print $NF; exit}'
}

CLASSIFYTE_PREFIX="$(resolve_classifyte_prefix)" \
    || error "Unable to locate Conda environment: $CLASSIFYTE_ENV_NAME"
if [ -z "$CLASSIFYTE_PREFIX" ]; then
    error "Unable to locate Conda environment: $CLASSIFYTE_ENV_NAME. Set CLASSIFYTE_ENV_PREFIX if it is installed at a nonstandard path."
fi
CLASSIFYTE_PYTHON="$CLASSIFYTE_PREFIX/bin/python"
if [ ! -x "$CLASSIFYTE_PYTHON" ]; then
    error "ClassifyTE Python not found: $CLASSIFYTE_PYTHON. Create $CLASSIFYTE_ENV_NAME or set CLASSIFYTE_ENV_PREFIX."
fi

run_classifyte_python() {
    PATH="$CLASSIFYTE_PREFIX/bin:$PATH" "$CLASSIFYTE_PYTHON" "$@"
}

# Create data directory
log "Setting up environment"
log "ClassifyTE environment: $CLASSIFYTE_PREFIX"
mkdir -p data || error "Failed to create data directory"

# Rename TEs
log "Renaming TE sequences"
if ! renameTE TE "$TE_LIBRARY" data/re.fa; then
    error "Failed to rename TE sequences"
fi

# Create symbolic links
log "Creating required symbolic links"
for dir in features nodes models; do
    if [ -e "$CLASSIFYTE_DIR/$dir" ]; then
        ln -sf "$CLASSIFYTE_DIR/$dir" ./ || error "Failed to link $dir directory"
    else
        error "Required directory not found: $CLASSIFYTE_DIR/$dir"
    fi
done

# Set number of threads for RepeatClassifier
if [ $THREADS -gt 1 ]; then
    RC_THREADS=$((THREADS - 1))
else
    RC_THREADS=1
fi

# Create temporary files to track completion (secure mktemp)
RC_DONE=$(mktemp /tmp/rc_done.XXXXXX) && rm "$RC_DONE"
CT_DONE=$(mktemp /tmp/ct_done.XXXXXX) && rm "$CT_DONE"

# Run RepeatClassifier in background
log "Starting RepeatClassifier with $RC_THREADS threads"
(
    RepeatClassifier -consensi data/re.fa --threads $RC_THREADS && touch "$RC_DONE"
) &
RC_PID=$!

# Run parallel feature generation and evaluation
log "Starting feature generation and evaluation"
(
    run_classifyte_python "$CLASSIFYTE_DIR/generate_feature_file_parallel.py" -j "$RC_THREADS" -f re.fa -d sup_features -o sup.csv \
    && run_classifyte_python "$CLASSIFYTE_DIR/evaluate.py" -f sup.csv -n node.txt -d sup_features -m ClassifyTE_combined.pkl -a lcpnb \
    && touch "$CT_DONE"
) &
CT_PID=$!

# Wait for both processes to complete
log "Waiting for classification processes to complete..."

wait_with_timeout() {
    local pid=$1
    local timeout=7200  # 2 hours timeout
    local count=0
    while kill -0 $pid 2>/dev/null; do
        sleep 10
        count=$((count + 10))
        if [ $count -ge $timeout ]; then
            kill $pid 2>/dev/null || true
            error "Process $pid timed out after $timeout seconds"
        fi
    done
}

wait_with_timeout $RC_PID
wait_with_timeout $CT_PID

# Check if both processes completed successfully
if [ ! -f "$RC_DONE" ] || [ ! -f "$CT_DONE" ]; then
    error "One or more classification processes failed"
fi

# Clean up temporary files
rm -f "$RC_DONE" "$CT_DONE"

# Process and combine results
log "Processing classification results"
if ! process_for_classify.py output/predicted_out_sup_features.csv result.txt; then
    error "Failed to process classification results"
fi

# Combine results
log "Combining results"
if ! Combine_for_Two; then
    error "Failed to combine results"
fi

# Post-process classifications
log "Post-processing classifications"
sed -i 's:#I:#LINE:' TEs.fa
sed -i 's:gypsy:LTR/Gypsy:' TEs.fa
sed -i 's:#Unknown#:#:' TEs.fa

log "Classification process completed successfully"
