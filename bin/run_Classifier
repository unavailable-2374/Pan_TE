#!/usr/bin/env bash

# Enable error handling
set -e
set -o pipefail

# Configuration
LOG_FILE="classifier.log"
TE_LIBRARY="raw_te_library.fa"
if [ ! -s "$TE_LIBRARY" ] && [ -s "raw_TEs.fa" ]; then
    TE_LIBRARY="raw_TEs.fa"
fi

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

error() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] ERROR: $1" | tee -a "$LOG_FILE" >&2
    exit 1
}

# Check arguments
if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    error "Usage: $0 <ClassifyTE_dir> [threads]"
fi

CLASSIFYTE_DIR="$1"
THREADS="${2:-$(nproc)}"
CLASSIFYTE_ENV_NAME="${CLASSIFYTE_ENV_NAME:-ClassifyTE_env}"

# Verify directory exists
if [ ! -d "$CLASSIFYTE_DIR" ]; then
    error "ClassifyTE directory not found: $CLASSIFYTE_DIR"
fi

# Auto-detect correct ClassifyTE root directory
# If user passed a subdirectory (e.g., .../ClassifyTE/models), walk up to find root
if [ ! -d "$CLASSIFYTE_DIR/features" ] || [ ! -d "$CLASSIFYTE_DIR/models" ]; then
    PARENT_DIR="$(dirname "$CLASSIFYTE_DIR")"
    if [ -d "$PARENT_DIR/features" ] && [ -d "$PARENT_DIR/models" ] && [ -d "$PARENT_DIR/nodes" ]; then
        log "Auto-corrected ClassifyTE path: $CLASSIFYTE_DIR -> $PARENT_DIR"
        CLASSIFYTE_DIR="$PARENT_DIR"
    fi
fi

log "Starting TE classification process"
log "ClassifyTE directory: $CLASSIFYTE_DIR"
log "Using $THREADS threads for classification"
log "Input TE library: $TE_LIBRARY"

if [ ! -s "$TE_LIBRARY" ]; then
    error "Input TE library not found or empty: raw_te_library.fa"
fi

# Resolve the isolated ClassifyTE environment without activating it. Calling
# `conda run` from an already-active main environment can execute that
# environment's compiler deactivation hooks with the wrong CONDA_PREFIX (for
# example, PGTA's gxx hook may look for a compiler under the Conda base prefix).
# Executing the target interpreter directly avoids that nested-activation
# failure while retaining ClassifyTE's pinned Python dependencies.
# Order matters: everything that does NOT need the `conda` command comes first. A batch
# job typically has the main environment on PATH without conda being initialised, so
# CONDA_EXE is unset and `conda` is not on PATH -- an environment that activates fine in
# an interactive login shell then looks "missing" here. CLASSIFYTE_SEARCHED accumulates
# what was tried so the error can say where it looked.
CLASSIFYTE_SEARCHED=""
_note_candidate() { CLASSIFYTE_SEARCHED="${CLASSIFYTE_SEARCHED}
    - $1"; }

resolve_classifyte_prefix() {
    local conda_cmd=""
    local conda_base=""
    local candidate=""
    local d=""
    local old_ifs=""

    if [ -n "${CLASSIFYTE_ENV_PREFIX:-}" ]; then
        CLASSIFYTE_PREFIX="$CLASSIFYTE_ENV_PREFIX"
        return 0
    fi

    # 1. Sibling of the active environment ($CONDA_PREFIX/../<name>). This is where
    #    `conda env create -f environment-classifyte.yml` puts it in a normal install,
    #    and it needs no conda invocation at all.
    if [ -n "${CONDA_PREFIX:-}" ]; then
        candidate="$(dirname "$CONDA_PREFIX")/$CLASSIFYTE_ENV_NAME"
        _note_candidate "$candidate (sibling of \$CONDA_PREFIX)"
        if [ -x "$candidate/bin/python" ]; then
            CLASSIFYTE_PREFIX="$candidate"
            return 0
        fi
    fi

    # 2. Explicitly configured env directories (clusters often relocate these off $HOME).
    old_ifs="$IFS"
    IFS=':'
    for d in ${CONDA_ENVS_PATH:-} ${CONDA_ENVS_DIRS:-}; do
        [ -n "$d" ] || continue
        candidate="$d/$CLASSIFYTE_ENV_NAME"
        IFS="$old_ifs"
        _note_candidate "$candidate (from \$CONDA_ENVS_PATH/\$CONDA_ENVS_DIRS)"
        if [ -x "$candidate/bin/python" ]; then
            CLASSIFYTE_PREFIX="$candidate"
            return 0
        fi
        IFS=':'
    done
    IFS="$old_ifs"

    # 3. Derive the base from $CONDA_EXE's location, without running it.
    if [ -n "${CONDA_EXE:-}" ]; then
        candidate="$(dirname "$(dirname "$CONDA_EXE")")/envs/$CLASSIFYTE_ENV_NAME"
        _note_candidate "$candidate (derived from \$CONDA_EXE)"
        if [ -x "$candidate/bin/python" ]; then
            CLASSIFYTE_PREFIX="$candidate"
            return 0
        fi
    fi

    # 4. Only now fall back to asking conda, which may not exist in a batch shell.
    if [ -n "${CONDA_EXE:-}" ] && [ -x "$CONDA_EXE" ]; then
        conda_cmd="$CONDA_EXE"
    elif command -v conda >/dev/null 2>&1; then
        conda_cmd="$(command -v conda)"
    else
        _note_candidate "(conda command unavailable in this shell -- CONDA_EXE unset and 'conda' not on PATH)"
        return 1
    fi

    conda_base="$("$conda_cmd" info --base 2>/dev/null)" || conda_base=""
    if [ -n "$conda_base" ]; then
        candidate="$conda_base/envs/$CLASSIFYTE_ENV_NAME"
        _note_candidate "$candidate (conda info --base)"
        if [ -x "$candidate/bin/python" ]; then
            CLASSIFYTE_PREFIX="$candidate"
            return 0
        fi
    fi

    _note_candidate "conda env list (searched for an env named $CLASSIFYTE_ENV_NAME)"
    CLASSIFYTE_PREFIX="$("$conda_cmd" env list 2>/dev/null \
        | awk -v env_name="$CLASSIFYTE_ENV_NAME" '$1 == env_name {print $NF; exit}')"
    [ -n "$CLASSIFYTE_PREFIX" ]
}

CLASSIFYTE_PREFIX=""
resolve_classifyte_prefix || true
if [ -z "$CLASSIFYTE_PREFIX" ]; then
    error "Unable to locate Conda environment: $CLASSIFYTE_ENV_NAME. Searched:${CLASSIFYTE_SEARCHED}
Create it with 'conda env create -f environment-classifyte.yml', or set CLASSIFYTE_ENV_PREFIX to its absolute prefix (the directory containing bin/python)."
fi
CLASSIFYTE_PYTHON="$CLASSIFYTE_PREFIX/bin/python"
if [ ! -x "$CLASSIFYTE_PYTHON" ]; then
    error "ClassifyTE Python not found: $CLASSIFYTE_PYTHON. Create $CLASSIFYTE_ENV_NAME or set CLASSIFYTE_ENV_PREFIX."
fi

run_classifyte_python() {
    PATH="$CLASSIFYTE_PREFIX/bin:$PATH" "$CLASSIFYTE_PYTHON" "$@"
}

# Create data directory
log "Setting up environment"
log "ClassifyTE environment: $CLASSIFYTE_PREFIX"
mkdir -p data || error "Failed to create data directory"

# Rename TEs
log "Renaming TE sequences"
if ! renameTE TE "$TE_LIBRARY" data/re.fa; then
    error "Failed to rename TE sequences"
fi

# Create symbolic links
log "Creating required symbolic links"
for dir in features nodes models; do
    if [ -e "$CLASSIFYTE_DIR/$dir" ]; then
        ln -sf "$CLASSIFYTE_DIR/$dir" ./ || error "Failed to link $dir directory"
    else
        error "Required directory not found: $CLASSIFYTE_DIR/$dir"
    fi
done

# Set number of threads for RepeatClassifier
if [ $THREADS -gt 1 ]; then
    RC_THREADS=$((THREADS - 1))
else
    RC_THREADS=1
fi

# Create temporary files to track completion (secure mktemp)
RC_DONE=$(mktemp /tmp/rc_done.XXXXXX) && rm "$RC_DONE"
CT_DONE=$(mktemp /tmp/ct_done.XXXXXX) && rm "$CT_DONE"

# Run RepeatClassifier in background
log "Starting RepeatClassifier with $RC_THREADS threads"
(
    RepeatClassifier -consensi data/re.fa --threads $RC_THREADS && touch "$RC_DONE"
) &
RC_PID=$!

# Run parallel feature generation and evaluation
log "Starting feature generation and evaluation"
(
    run_classifyte_python "$CLASSIFYTE_DIR/generate_feature_file_parallel.py" -j "$RC_THREADS" -f re.fa -d sup_features -o sup.csv \
    && run_classifyte_python "$CLASSIFYTE_DIR/evaluate.py" -f sup.csv -n node.txt -d sup_features -m ClassifyTE_combined.pkl -a lcpnb \
    && touch "$CT_DONE"
) &
CT_PID=$!

# Wait for both processes to complete
log "Waiting for classification processes to complete..."

# ClassifyTE's k-mer step launches THREE JVMs per sequence (kanalyze counts 2-, 3- and
# 4-mers separately), so its runtime is proportional to the library size -- a library of
# 8.5k consensi means >25k JVM starts. A constant 2-hour ceiling therefore kills large
# but perfectly healthy runs. Scale the hang guard with the sequence count and let the
# operator override it outright. This is a guard against a hung process, not a budget.
TE_SEQ_COUNT="$(grep -c '^>' "$TE_LIBRARY" 2>/dev/null || echo 0)"
CLASSIFYTE_TIMEOUT="${CLASSIFYTE_TIMEOUT:-$(( 7200 > TE_SEQ_COUNT * 2 ? 7200 : TE_SEQ_COUNT * 2 ))}"
log "Classification hang guard: ${CLASSIFYTE_TIMEOUT}s for $TE_SEQ_COUNT sequences (override with CLASSIFYTE_TIMEOUT)"

# How many per-sequence k-mer outputs kanalyze failed to produce. A missing file here is
# the usual sign that `java` is unusable (ClassifyTE needs a JDK, which nothing declares
# as a dependency), and it otherwise surfaces only as one buried stderr line per sequence
# from the Java collector, hours later.
report_kmer_gaps() {
    local kdir="sup_features/kanalyze-2.0.0/output_data"
    local expected="$TE_SEQ_COUNT" produced=0 k=""
    [ -d "$kdir" ] || return 0
    for k in 2mer 3mer 4mer; do
        [ -d "$kdir/$k" ] || continue
        produced=$(find "$kdir/$k" -name '*.txt' 2>/dev/null | wc -l)
        if [ "$expected" -gt 0 ] && [ "$produced" -lt "$expected" ]; then
            log "  kanalyze $k: $produced/$expected outputs present ($(( expected - produced )) missing)"
        fi
    done
}

wait_with_timeout() {
    local pid=$1
    local label=$2
    local count=0
    while kill -0 $pid 2>/dev/null; do
        sleep 10
        count=$((count + 10))
        if [ $count -ge "$CLASSIFYTE_TIMEOUT" ]; then
            kill $pid 2>/dev/null || true
            log "$label exceeded ${CLASSIFYTE_TIMEOUT}s; k-mer output status:"
            report_kmer_gaps
            error "$label (pid $pid) timed out after ${CLASSIFYTE_TIMEOUT}s. If the run was
merely slow, raise CLASSIFYTE_TIMEOUT. If k-mer outputs are missing above, check that a
JDK is usable ('java -version' and 'javac -version'): ClassifyTE's kanalyze step needs one."
        fi
    done
}

wait_with_timeout $RC_PID "RepeatClassifier"
wait_with_timeout $CT_PID "ClassifyTE feature generation/evaluation"

# Check if both processes completed successfully
if [ ! -f "$RC_DONE" ] || [ ! -f "$CT_DONE" ]; then
    error "One or more classification processes failed"
fi

# Clean up temporary files
rm -f "$RC_DONE" "$CT_DONE"

# Process and combine results
log "Processing classification results"
if ! process_for_classify.py output/predicted_out_sup_features.csv result.txt; then
    error "Failed to process classification results"
fi

# Combine results
log "Combining results"
if ! Combine_for_Two; then
    error "Failed to combine results"
fi

# Post-process classifications
log "Post-processing classifications"
sed -i 's:#I:#LINE:' TEs.fa
sed -i 's:gypsy:LTR/Gypsy:' TEs.fa
sed -i 's:#Unknown#:#:' TEs.fa

log "Classification process completed successfully"
