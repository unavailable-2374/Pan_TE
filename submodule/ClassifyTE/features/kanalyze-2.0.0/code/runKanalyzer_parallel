#!/bin/bash
#purpose: run Kmer counter in parallel
#author: Optimized for parallel processing
#
# KAnalyze writes its temporary segment file (segment_1.bin) next to the output
# file unless --temploc is given. With every job writing into the same 2mer/3mer/4mer
# directory, concurrent jobs truncate each other's segment file and leave an empty
# k-mer table behind (about half of all outputs on a 64-core node), which the
# feature collector then reads as all-zero counts. Each job therefore gets its own
# --temploc, and any failed or empty output fails the whole step.

# Get number of CPU cores, use 80% to avoid system overload
MAX_JOBS=$(( $(nproc) * 4 / 5 ))
[ "$MAX_JOBS" -ge 1 ] || MAX_JOBS=1
echo "Using $MAX_JOBS parallel jobs on $(nproc) cores"

input_path="../input_data/"
output_path2mer="../output_data/2mer/"
output_path3mer="../output_data/3mer/"
output_path4mer="../output_data/4mer/"
temp_root=$(mktemp -d "${TMPDIR:-/tmp}/kanalyze.XXXXXX") || exit 1
trap 'rm -rf "$temp_root"' EXIT

# Count one k-mer size for one file in a private temp dir; a non-empty table is required.
count_kmers() {
    local k=$1 file=$2 out=$3
    if [ -s "$out/$file.txt" ]; then
        return 0
    fi
    local temp_dir
    temp_dir=$(mktemp -d "$temp_root/$file.k$k.XXXXXX") || return 1
    java -Xmx1G -jar kanalyze.jar count -k "$k" -f fasta --temploc="$temp_dir" \
        -o "$out/$file.txt" "$input_path/$file"
    local status=$?
    rm -rf "$temp_dir"
    if [ $status -ne 0 ] || [ ! -s "$out/$file.txt" ]; then
        echo "FAILED: ${k}-mer count for $file (exit $status)" >&2
        return 1
    fi
}

# Function to process a single file for all k-mer sizes
process_file() {
    local file=$1
    echo "Processing file: $file"
    count_kmers 2 "$file" "$output_path2mer" || return 1
    count_kmers 3 "$file" "$output_path3mer" || return 1
    count_kmers 4 "$file" "$output_path4mer" || return 1
    echo "Completed: $file"
}

# Export function and variables for parallel execution
export -f count_kmers process_file
export input_path output_path2mer output_path3mer output_path4mer temp_root

echo "Starting parallel k-mer feature generation..."

# Use GNU parallel or xargs for parallel processing; both exit non-zero if any job failed
if command -v parallel >/dev/null 2>&1; then
    parallel -j "$MAX_JOBS" process_file {} < list.txt
else
    xargs -P "$MAX_JOBS" -I {} bash -c 'process_file "$@"' _ {} < list.txt
fi
status=$?

if [ $status -ne 0 ]; then
    echo "ERROR: k-mer counting failed for one or more sequences" >&2
    exit 1
fi

echo "Parallel k-mer feature generation completed!"
